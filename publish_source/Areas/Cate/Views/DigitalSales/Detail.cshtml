@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesModel

@{
    ViewBag.Title = $"Chi tiết: {Model.Code} - {Model.Title}";
    var totalTasks = Model.TrackingTasks?.Count ?? 0;
    var completedTasks = Model.TrackingTasks?.Count(t => t.Status == 3) ?? 0;
    var progressPercent = totalTasks > 0 ? (int)Math.Round((double)completedTasks * 100 / totalTasks) : 0;
}

@section PageTitle{
    <div class="page-header pb-2">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <a href="@Url.Action("Index", "DigitalSales", new { area = "Cate" })" class="btn btn-sm btn-outline-secondary mr-2">
                    <i class="fa fa-arrow-left mr-1"></i> Danh sách
                </a>
                <span class="badge @(Model.BusinessType == 1 ? "badge-primary" : "badge-success") text-90 px-2 py-1 mr-1">
                    @(Model.BusinessType == 1 ? "Cơ hội kinh doanh" : "Dự án")
                </span>
                <span class="badge badge-info text-90 px-2 py-1 mr-2">
                    @Model.StatusName
                </span>
                <span class="text-120 font-weight-bold text-dark">[@Model.Code] @Model.Title</span>
            </div>
            <div class="mt-2 mt-md-0">
                <button type="button" class="btn btn-sm btn-warning text-dark font-weight-bold px-3 mr-1" onclick="openChangeStatusModal(@Model.DigitalSalesID);">
                    <i class="fa fa-exchange-alt mr-1"></i> Chuyển trạng thái
                </button>
                <button type="button" class="btn btn-sm btn-primary px-3" onclick="openEditSalesModal(@Model.DigitalSalesID);">
                    <i class="fa fa-edit mr-1"></i> Chỉnh sửa
                </button>
            </div>
        </div>
    </div>
}

<!-- THẺ CHỈ SỐ NHANH (METRIC TILES) -->
<div class="row mb-3">
    <div class="col-xl-3 col-md-6 mb-2">
        <div class="card border-0 bgc-primary-l4 border-l-4 brc-primary-m1 p-3">
            <div class="d-flex align-items-center">
                <div class="mr-3">
                    <span class="d-inline-block bgc-primary text-white text-140 p-2 radius-round">
                        <i class="fa fa-money-bill-wave fa-fw"></i>
                    </span>
                </div>
                <div>
                    <div class="text-secondary text-85 text-uppercase font-weight-bold">Doanh thu dự kiến</div>
                    <div class="text-130 font-weight-bold text-primary-d2">
                        @((Model.TotalExpectedRevenue ?? 0).ToString("N0")) <small class="text-80">VNĐ</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-2">
        <div class="card border-0 bgc-success-l4 border-l-4 brc-success-m1 p-3">
            <div class="d-flex align-items-center">
                <div class="mr-3">
                    <span class="d-inline-block bgc-success text-white text-140 p-2 radius-round">
                        <i class="fa fa-file-invoice-dollar fa-fw"></i>
                    </span>
                </div>
                <div>
                    <div class="text-secondary text-85 text-uppercase font-weight-bold">Doanh thu thực tế (Ký HĐ)</div>
                    <div class="text-130 font-weight-bold text-success-d2">
                        @((Model.TotalActualRevenue ?? 0).ToString("N0")) <small class="text-80">VNĐ</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-2">
        <div class="card border-0 bgc-purple-l4 border-l-4 brc-purple-m1 p-3">
            <div class="d-flex align-items-center">
                <div class="mr-3">
                    <span class="d-inline-block bgc-purple text-white text-140 p-2 radius-round">
                        <i class="fa fa-cubes fa-fw"></i>
                    </span>
                </div>
                <div>
                    <div class="text-secondary text-85 text-uppercase font-weight-bold">Sản phẩm / Dịch vụ số</div>
                    <div class="text-130 font-weight-bold text-purple-d2">
                        @(Model.Products?.Count ?? 0) <small class="text-80">sản phẩm</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-2">
        <div class="card border-0 bgc-orange-l4 border-l-4 brc-orange-m1 p-3">
            <div class="d-flex align-items-center">
                <div class="mr-3">
                    <span class="d-inline-block bgc-orange text-white text-140 p-2 radius-round">
                        <i class="fa fa-tasks fa-fw"></i>
                    </span>
                </div>
                <div class="w-100">
                    <div class="d-flex justify-content-between">
                        <span class="text-secondary text-85 text-uppercase font-weight-bold">Tiến trình thực hiện</span>
                        <span class="text-85 font-weight-bold text-orange-d2">@completedTasks/@totalTasks công việc</span>
                    </div>
                    <div class="progress mt-1" style="height: 10px;">
                        <div class="progress-bar bgc-orange" role="progressbar" style="width: @progressPercent%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 5 TABS NỘI DUNG 360 ĐỘ -->
<div class="card dcard">
    <div class="card-header p-0 bgc-grey-l4 border-b-1 brc-grey-l1">
        <ul class="nav nav-tabs nav-tabs-simple border-0" role="tablist">
            <li class="nav-item">
                <a class="nav-link active px-4 py-3 font-weight-bold" id="tab-overview-link" data-toggle="tab" href="#tab-overview" role="tab" aria-selected="true">
                    <i class="fa fa-info-circle mr-1 text-primary"></i> 1. Thông tin tổng quan
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-4 py-3 font-weight-bold" id="tab-products-link" data-toggle="tab" href="#tab-products" role="tab" aria-selected="false">
                    <i class="fa fa-cubes mr-1 text-purple"></i> 2. Sản phẩm & Doanh thu
                    <span class="badge badge-pill badge-purple ml-1">@(Model.Products?.Count ?? 0)</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-4 py-3 font-weight-bold" id="tab-members-link" data-toggle="tab" href="#tab-members" role="tab" aria-selected="false">
                    <i class="fa fa-users mr-1 text-blue"></i> 3. Thành viên tham gia
                    <span class="badge badge-pill badge-primary ml-1">@(Model.Members?.Count ?? 0)</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-4 py-3 font-weight-bold" id="tab-tracking-link" data-toggle="tab" href="#tab-tracking" role="tab" aria-selected="false">
                    <i class="fa fa-clipboard-check mr-1 text-orange"></i> 4. Tiến trình & Checklist
                    <span class="badge badge-pill badge-warning ml-1">@completedTasks/@totalTasks</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-4 py-3 font-weight-bold" id="tab-timeline-link" data-toggle="tab" href="#tab-timeline" role="tab" aria-selected="false">
                    <i class="fa fa-history mr-1 text-green"></i> 5. Dòng thời gian (Timeline)
                    <span class="badge badge-pill badge-success ml-1">@(Model.Timelines?.Count ?? 0)</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="card-body p-3">
        <div class="tab-content">
            <!-- TAB 1: THÔNG TIN TỔNG QUAN -->
            <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card border-1 brc-grey-l2 p-3 mb-3">
                            <h6 class="text-primary font-weight-bold border-b-1 brc-grey-l2 pb-2 mb-3">
                                <i class="fa fa-building mr-1"></i> Khách hàng & Người liên hệ
                            </h6>
                            <table class="table table-sm table-borderless text-90 mb-0">
                                <tr>
                                    <td class="text-secondary font-weight-bold" style="width: 140px;">Khách hàng:</td>
                                    <td class="font-weight-bold text-dark">@Model.CustomerName</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary font-weight-bold">Người liên hệ:</td>
                                    <td>@(string.IsNullOrEmpty(Model.ContactPersonName) ? "Chưa có thông tin" : Model.ContactPersonName)</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary font-weight-bold">Điện thoại:</td>
                                    <td>@(string.IsNullOrEmpty(Model.ContactPersonPhone) ? "—" : Model.ContactPersonPhone)</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary font-weight-bold">Email:</td>
                                    <td>@(string.IsNullOrEmpty(Model.ContactPersonEmail) ? "—" : Model.ContactPersonEmail)</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border-1 brc-grey-l2 p-3 mb-3">
                            <h6 class="text-primary font-weight-bold border-b-1 brc-grey-l2 pb-2 mb-3">
                                <i class="fa fa-user-shield mr-1"></i> Phân công & Tiến độ
                            </h6>
                            <table class="table table-sm table-borderless text-90 mb-0">
                                <tr>
                                    <td class="text-secondary font-weight-bold" style="width: 150px;">AM chủ trì:</td>
                                    <td class="font-weight-bold text-primary">@(string.IsNullOrEmpty(Model.AssignedEmployeeName) ? "Chưa chỉ định" : Model.AssignedEmployeeName)</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary font-weight-bold">Bộ phận:</td>
                                    <td>@(string.IsNullOrEmpty(Model.DepartmentName) ? "—" : Model.DepartmentName)</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary font-weight-bold">Xác suất thành công:</td>
                                    <td>
                                        <span class="badge badge-info px-2">@(Model.ClosingProbability.HasValue ? $"{Model.ClosingProbability.Value}%" : "50%")</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-secondary font-weight-bold">Thời gian:</td>
                                    <td>
                                        @(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "—")
                                        ➔
                                        @(Model.ExpectedDate.HasValue ? Model.ExpectedDate.Value.ToString("dd/MM/yyyy") : "—")
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="card border-1 brc-grey-l2 p-3 mb-3">
                            <h6 class="text-primary font-weight-bold border-b-1 brc-grey-l2 pb-2 mb-3">
                                <i class="fa fa-file-contract mr-1"></i> Thông tin Hợp đồng & Hồ sơ pháp lý
                            </h6>
                            <div class="row text-90">
                                <div class="col-md-4 mb-2">
                                    <span class="text-secondary font-weight-bold">Số hợp đồng:</span>
                                    <span class="ml-1 font-weight-bold">@(string.IsNullOrEmpty(Model.ContractNo) ? "Chưa có" : Model.ContractNo)</span>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <span class="text-secondary font-weight-bold">Giá trị hợp đồng:</span>
                                    <span class="ml-1 font-weight-bold text-success">@(Model.ContractValue.HasValue ? Model.ContractValue.Value.ToString("N0") + " VNĐ" : "—")</span>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <span class="text-secondary font-weight-bold">Ngày ký:</span>
                                    <span class="ml-1">@(Model.ContractSignDate.HasValue ? Model.ContractSignDate.Value.ToString("dd/MM/yyyy") : "—")</span>
                                </div>
                                <div class="col-md-12 mt-2">
                                    <span class="text-secondary font-weight-bold">File đính kèm hồ sơ:</span>
                                    @if (!string.IsNullOrEmpty(Model.FileAttach))
                                    {
                                        <a href="@Model.FileAttach" target="_blank" class="btn btn-xs btn-outline-primary ml-2">
                                            <i class="fa fa-download mr-1"></i> Tải file tài liệu
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted ml-2">Chưa đính kèm file</span>
                                    }
                                </div>
                                <div class="col-md-12 mt-2">
                                    <span class="text-secondary font-weight-bold">Ghi chú chung:</span>
                                    <p class="text-dark mt-1 p-2 bgc-grey-l5 radius-1 mb-0">
                                        @(string.IsNullOrEmpty(Model.Note) ? "Không có ghi chú." : Model.Note)
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: SẢN PHẨM & DỊCH VỤ SỐ -->
            <div class="tab-pane fade" id="tab-products" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-purple font-weight-bold mb-0">
                        <i class="fa fa-cubes mr-1"></i> Danh sách Sản phẩm / Dịch vụ số đính kèm
                    </h6>
                    <button type="button" class="btn btn-sm btn-purple px-3" onclick="openAddProductModal(@Model.DigitalSalesID);">
                        <i class="fa fa-plus mr-1"></i> Thêm sản phẩm / DV số
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover text-90" id="tblProducts">
                        <thead class="bgc-secondary-l1 text-secondary-d2">
                            <tr>
                                <th style="width: 40px;" class="text-center">STT</th>
                                <th>Sản phẩm / Dịch vụ số</th>
                                <th>Gói cước / Quy mô</th>
                                <th style="width: 80px;" class="text-center">Số lượng</th>
                                <th class="text-right">DT dự kiến (VNĐ)</th>
                                <th class="text-right">DT thực tế (VNĐ)</th>
                                <th>Thời hạn</th>
                                <th>Ghi chú</th>
                                <th style="width: 100px;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Products != null && Model.Products.Count > 0)
                            {
                                int idx = 1;
                                foreach (var p in Model.Products)
                                {
                                    <tr>
                                        <td class="text-center">@idx</td>
                                        <td class="font-weight-bold text-dark">@p.ProductServiceName</td>
                                        <td>@(string.IsNullOrEmpty(p.PackageName) ? "—" : p.PackageName)</td>
                                        <td class="text-center">@p.Quantity</td>
                                        <td class="text-right font-weight-bold text-primary">@((p.ExpectedRevenue ?? 0).ToString("N0"))</td>
                                        <td class="text-right font-weight-bold text-success">@((p.ActualRevenue ?? 0).ToString("N0"))</td>
                                        <td>
                                            @(p.StartDate.HasValue ? p.StartDate.Value.ToString("dd/MM/yyyy") : "")
                                            @(p.EndDate.HasValue ? " ➔ " + p.EndDate.Value.ToString("dd/MM/yyyy") : "")
                                        </td>
                                        <td>@(string.IsNullOrEmpty(p.Note) ? "—" : p.Note)</td>
                                        <td class="text-center">
                                            <a href="javascript:void(0);" class="text-primary mr-2" title="Chỉnh sửa" onclick="openEditProductModal(@p.SalesProductID, @Model.DigitalSalesID);">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a href="javascript:void(0);" class="text-danger" title="Xóa" onclick="deleteProductItem(@p.SalesProductID, @Model.DigitalSalesID);">
                                                <i class="fa fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4 text-muted">
                                        <i class="fa fa-inbox fa-2x mb-2 d-block text-secondary-l1"></i>
                                        Chưa có sản phẩm / dịch vụ số nào. Vui lòng bấm <strong>"Thêm sản phẩm / DV số"</strong>.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bgc-grey-l4 font-weight-bold">
                            <tr>
                                <td colspan="4" class="text-right">TỔNG CỘNG:</td>
                                <td class="text-right text-primary">@((Model.TotalExpectedRevenue ?? 0).ToString("N0")) VNĐ</td>
                                <td class="text-right text-success">@((Model.TotalActualRevenue ?? 0).ToString("N0")) VNĐ</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- TAB 3: THÀNH VIÊN THAM GIA -->
            <div class="tab-pane fade" id="tab-members" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-blue font-weight-bold mb-0">
                        <i class="fa fa-users mr-1"></i> Danh sách Nhân sự / Thành viên tham gia
                    </h6>
                    <button type="button" class="btn btn-sm btn-primary px-3" onclick="openAddMemberModal(@Model.DigitalSalesID);">
                        <i class="fa fa-user-plus mr-1"></i> Thêm thành viên
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover text-90" id="tblMembers">
                        <thead class="bgc-secondary-l1 text-secondary-d2">
                            <tr>
                                <th style="width: 40px;" class="text-center">STT</th>
                                <th>Họ và tên</th>
                                <th>Tài khoản</th>
                                <th>Liên hệ (Email / Phone)</th>
                                <th>Vai trò / Nhiệm vụ</th>
                                <th style="width: 120px;" class="text-center">Chủ trì (AM)</th>
                                <th>Ghi chú</th>
                                <th style="width: 80px;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Members != null && Model.Members.Count > 0)
                            {
                                int idx = 1;
                                foreach (var m in Model.Members)
                                {
                                    <tr>
                                        <td class="text-center">@idx</td>
                                        <td class="font-weight-bold text-dark">@m.FullName</td>
                                        <td>@m.UserName</td>
                                        <td>@(m.Email ?? m.Phone ?? "—")</td>
                                        <td>@(string.IsNullOrEmpty(m.RoleTitle) ? "Thành viên" : m.RoleTitle)</td>
                                        <td class="text-center">
                                            @if (m.IsAM)
                                            {
                                                <span class="badge badge-success px-2 py-1"><i class="fa fa-check mr-1"></i> AM Chủ trì</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrEmpty(m.Note) ? "—" : m.Note)</td>
                                        <td class="text-center">
                                            <a href="javascript:void(0);" class="text-danger" title="Xóa thành viên" onclick="deleteMemberItem(@m.MemberID, @Model.DigitalSalesID);">
                                                <i class="fa fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="fa fa-user-friends fa-2x mb-2 d-block text-secondary-l1"></i>
                                        Chưa có thành viên nào. Bấm <strong>"Thêm thành viên"</strong> để phân công nhân sự.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 4: TIẾN TRÌNH & CHECKLIST -->
            <div class="tab-pane fade" id="tab-tracking" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-orange font-weight-bold mb-0">
                        <i class="fa fa-tasks mr-1"></i> Checklist Tiến trình thực hiện dự án theo chuẩn SLA
                    </h6>
                    <button type="button" class="btn btn-sm btn-orange px-3" onclick="openAddTrackingModal(@Model.DigitalSalesID);">
                        <i class="fa fa-plus mr-1"></i> Thêm công việc tùy biến
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover text-90" id="tblTracking">
                        <thead class="bgc-secondary-l1 text-secondary-d2">
                            <tr>
                                <th style="width: 40px;" class="text-center">STT</th>
                                <th>Tên công việc / Đầu mục tiến trình</th>
                                <th>Quy trình liên quan</th>
                                <th>Người thực hiện</th>
                                <th>Bắt đầu</th>
                                <th>Hạn chót (Deadline)</th>
                                <th style="width: 130px;" class="text-center">Trạng thái</th>
                                <th>Kết quả / File</th>
                                <th style="width: 110px;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TrackingTasks != null && Model.TrackingTasks.Count > 0)
                            {
                                int idx = 1;
                                foreach (var t in Model.TrackingTasks)
                                {
                                    <tr class="@(t.Status == 3 ? "bgc-success-l5" : (t.IsOverdue == 1 ? "bgc-danger-l5" : ""))">
                                        <td class="text-center">@idx</td>
                                        <td class="font-weight-bold text-dark">
                                            @t.TaskName
                                            @if (t.IsCustomTask)
                                            {
                                                <span class="badge badge-light-secondary text-75 ml-1">Tùy biến</span>
                                            }
                                        </td>
                                        <td class="text-secondary">@(string.IsNullOrEmpty(t.ProcessName) ? "Checklist chung" : t.ProcessName)</td>
                                        <td>@(string.IsNullOrEmpty(t.AssignedUserName) ? "Chưa giao" : t.AssignedUserName)</td>
                                        <td>@(t.StartDate != DateTime.MinValue ? t.StartDate.ToString("dd/MM/yyyy") : "—")</td>
                                        <td>
                                            @if (t.Deadline.HasValue)
                                            {
                                                <span class="@(t.IsOverdue == 1 ? "text-danger font-weight-bold" : "")">
                                                    @t.Deadline.Value.ToString("dd/MM/yyyy")
                                                    @if (t.IsOverdue == 1)
                                                    {
                                                        <i class="fa fa-exclamation-circle text-danger ml-1" title="Đã quá hạn!"></i>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @switch (t.Status)
                                            {
                                                case 1:
                                                    <span class="badge badge-secondary px-2">Chưa làm</span>
                                                    break;
                                                case 2:
                                                    <span class="badge badge-warning px-2">Đang làm</span>
                                                    break;
                                                case 3:
                                                    <span class="badge badge-success px-2"><i class="fa fa-check mr-1"></i> Hoàn thành</span>
                                                    break;
                                                case 4:
                                                    <span class="badge badge-danger px-2">Quá hạn</span>
                                                    break;
                                                default:
                                                    <span class="badge badge-light">Khác</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(t.AttachmentFile))
                                            {
                                                <a href="@t.AttachmentFile" target="_blank" class="badge badge-light-primary mr-1" title="Tải file đính kèm">
                                                    <i class="fa fa-paperclip"></i> File
                                                </a>
                                            }
                                            @(string.IsNullOrEmpty(t.ResultNote) ? "" : t.ResultNote)
                                        </td>
                                        <td class="text-center">
                                            <a href="javascript:void(0);" class="text-primary mr-2" title="Cập nhật tiến trình" onclick="openEditTrackingModal(@t.TrackingID, @Model.DigitalSalesID);">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a href="javascript:void(0);" class="text-danger" title="Xóa tiến trình" onclick="deleteTrackingItem(@t.TrackingID, @Model.DigitalSalesID);">
                                                <i class="fa fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4 text-muted">
                                        <i class="fa fa-clipboard-list fa-2x mb-2 d-block text-secondary-l1"></i>
                                        Chưa có tiến trình công việc nào. Bấm <strong>"Thêm công việc tùy biến"</strong> hoặc chuyển trạng thái để tự sinh tiến trình theo danh mục.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 5: DÒNG THỜI GIAN (TIMELINE) -->
            <div class="tab-pane fade" id="tab-timeline" role="tabpanel">
                <h6 class="text-green font-weight-bold mb-3">
                    <i class="fa fa-history mr-1"></i> Lịch sử và Dòng thời gian chuyển đổi trạng thái (Audit Trail)
                </h6>

                @if (Model.Timelines != null && Model.Timelines.Count > 0)
                {
                    <div class="timeline-container px-3">
                        @foreach (var tl in Model.Timelines)
                        {
                            <div class="timeline-item d-flex mb-3">
                                <div class="timeline-badge mr-3">
                                    <span class="d-inline-block bgc-primary text-white p-2 radius-round text-90">
                                        <i class="fa fa-check"></i>
                                    </span>
                                </div>
                                <div class="timeline-content card border-1 brc-grey-l2 p-3 flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="font-weight-bold text-dark">
                                            @if (!string.IsNullOrEmpty(tl.FromStatusName))
                                            {
                                                <span class="badge badge-secondary">@tl.FromStatusName</span>
                                                <i class="fa fa-arrow-right mx-1 text-secondary"></i>
                                            }
                                            <span class="badge badge-success">@tl.ToStatusName</span>
                                        </span>
                                        <span class="text-secondary text-85">
                                            <i class="fa fa-clock mr-1"></i> @tl.ActionDate.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>
                                    <div class="text-90 text-dark mb-1">
                                        @tl.Note
                                    </div>
                                    <div class="d-flex justify-content-between text-80 text-secondary">
                                        <span><i class="fa fa-user mr-1"></i> Thực hiện bởi: <strong>@tl.ActionBy</strong></span>
                                        @if (!string.IsNullOrEmpty(tl.AttachmentPath))
                                        {
                                            <a href="@tl.AttachmentPath" target="_blank" class="text-primary font-weight-bold">
                                                <i class="fa fa-paperclip mr-1"></i> File biên bản / minh chứng
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-history fa-2x mb-2 d-block text-secondary-l1"></i>
                        Chưa có lịch sử chuyển trạng thái nào.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- CONTAINER LOAD MODALS AJAX -->
<div id="modalContainer"></div>

@section BottomScript {
    <script src="~/Areas/Cate/Views/DigitalSales/DigitalSalesDetail.js"></script>
}
