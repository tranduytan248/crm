@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ContactPersonsSearchModel
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("ContactPersons_Title");
}

@section PageTitle { @ViewBag.Title }

@section PageAction {
    @Html.Button(true, "AddContactPersons", Url.Action("Add", new { area = "Cate" }),
                        "<i class='fa fa-plus'></i>",
                        AppProcessor.Messagor.GetMessage("Button_Add"),
                        new
                        {
                            @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right mr-1",
                            data_width = "900px"
                        })

    @Html.Button(true, "ImportContactPersons", Url.Action("Import", new { area = "Cate" }),
                        "<i class='fa fa-upload'></i>",
                        AppProcessor.Messagor.GetMessage("Button_Import_ContactPersons"),
                        new
                        {
                            @class = "btn btn-light-green btn-h-green btn-a-green border-0 radius-3 py-2 text-600 text-90 pull-right mr-1",
                            data_width = "900px"
                        })
}

<div class="mt-3">
    @Html.Partial("_Search", Model)
</div>

<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSContactPersons"
                   class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table"
                   width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>Mã NLH</th>
                        <th>@AppProcessor.Messagor.GetMessage("ContactPersonal_FullName_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ContactPersonal_Email_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ContactPersonal_Address_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Label_Contact")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Label_Status")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript {
    <style>
        #DSContactPersons td:first-child {
            border-left: none !important;
        }
    </style>
    <script src="@Url.Content("~/Areas/Cate/Views/ContactPersons/ContactPersons.js")"></script>
}