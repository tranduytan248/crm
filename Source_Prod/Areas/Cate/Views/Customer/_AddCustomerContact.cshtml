@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("ContactPersonal_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Add", "CustomerContact", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "CustomerContact_OnProcessSuccess(data, 'AddCustomerContact')"
    }, new { @class = "form-horizontal", id = "AddCustomerContact" }))
    {
        <div id="bodyForm">
            @Html.Partial("_CustomerContact")
        </div>
    }
}

@section SubmitControl{

}