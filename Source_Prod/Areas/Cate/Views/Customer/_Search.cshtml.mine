@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_CustomerSearchModel

<div class="card dcard">
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3" id="SearchCustomer">
            <div class="form-group row">
                <label class="col-form-label text-sm-right pr-0 font-bold col-md-2">@AppProcessor.Messagor.GetMessage("Label_TuKhoa")</label>
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.Keyword, new { @class = "form-control", placeholder = "Tìm kiếm theo tu khoa" })
                </div>
            </div>
            <div class="form-group row">
                <div class="col-6">
                    <div class="row">
                        @Html.TitleFor(model => model.CustomerTypeID, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.CustomerTypeID, new SelectList(Model.ListCustomerType, "Value", "Text"), "", new { @class = "form-control", data_placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="row">
                        @Html.TitleFor(model => model.CustomerStatusID, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.CustomerStatusID, new SelectList(Model.ListStatus, "Value", "Text"), "", new { @class = "form-control", data_placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="_tableCustomer.ajax.reload(null, false);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
            </div>
        </div>
    </div>
</div>