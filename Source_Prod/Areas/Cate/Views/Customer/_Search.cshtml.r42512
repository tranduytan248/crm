@using TSFramework.Libs.Processors
<style>
    #filterStatus + .select2-container .select2-selection,
    #filterCompanyType + .select2-container .select2-selection {
        height: 31px !important;
        min-height: 31px !important;
    }
    #filterStatus + .select2-container .select2-selection__rendered,
    #filterCompanyType + .select2-container .select2-selection__rendered {
        line-height: 29px !important;
        font-size: 0.875rem;
    }
    #filterStatus + .select2-container .select2-selection__arrow,
    #filterCompanyType + .select2-container .select2-selection__arrow {
        height: 29px !important;
    }
</style>
<div class="mt-2 mb-2">
    <div class="card dcard p-3">
        <div class="row">
            <div class="col-md-4">
                <input type="text" id="filterKeyword" class="form-control form-control-sm"
                       placeholder="Tìm theo tên, tên viết tắt, MST, SĐT, email..." />
            </div>
            <div class="col-md-2">
                <select id="filterStatus" class="form-control form-control-sm"
                        data-placeholder="-- Trạng thái --">
                    <option value=""></option>
                    <option value="1">Tiềm năng</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="filterCompanyType" class="form-control form-control-sm"
                        data-placeholder="-- Loại khách hàng --">
                    <option value=""></option>
                </select>
            </div>
            <div class="col-md-2">
                <button id="btnFilter" class="btn btn-sm btn-primary w-100">
                    <i class="fa fa-search"></i> Lọc
                </button>
            </div>
            <div class="col-md-2">
                <button id="btnClearFilter" class="btn btn-sm btn-secondary w-100">
                    <i class="fa fa-times"></i> Xóa lọc
                </button>
            </div>
        </div>
    </div>
</div>
