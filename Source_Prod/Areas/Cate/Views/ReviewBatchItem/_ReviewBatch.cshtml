@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Review"), AppProcessor.Messagor.GetMessage("ProjectOpportunity_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    <style>
        /* Panel rà soát neo bên phải màn hình để nhập nhanh, không che toàn bộ trang.
           Lớp phủ của modal được cho xuyên chuột để vẫn thao tác được với nội dung phía sau. */
        #modal_ReviewBatch.review-dock-right {
            padding-right: 0 !important;
            pointer-events: none;
            overflow: visible;
        }

        #modal_ReviewBatch.review-dock-right .modal-dialog {
            position: fixed;
            top: 0;
            right: 0;
            margin: 0;
            width: 760px;
            max-width: 96vw;
            height: 100%;
            display: flex;
            align-items: stretch;
            pointer-events: auto;
        }

        #modal_ReviewBatch.review-dock-right .modal-content {
            width: 100%;
            height: 100%;
            border: 0;
            border-radius: 0;
            display: flex;
            flex-direction: column;
            box-shadow: -4px 0 18px rgba(0, 0, 0, .18);
        }

        #modal_ReviewBatch.review-dock-right .modal-body {
            flex: 1 1 auto;
            overflow-y: auto;
        }

        #modal_ReviewBatch.review-dock-right .modal-footer {
            flex: 0 0 auto;
        }

        /* Hiệu ứng trượt vào từ cạnh phải */
        #modal_ReviewBatch.review-dock-right.fade .modal-dialog {
            transform: translateX(100%);
            transition: transform .25s ease-out;
        }

        #modal_ReviewBatch.review-dock-right.show .modal-dialog {
            transform: translateX(0);
        }

        /* Thu gọn vùng soạn thảo để form vừa một màn hình, không phải cuộn nhiều */
        #modal_ReviewBatch.review-dock-right .cke_contents {
            height: 250px !important;
        }

        /* Khi panel mở, trang nền vẫn cuộn và bấm được như bình thường */
        body.review-dock-open {
            overflow: auto !important;
            padding-right: 0 !important;
        }

        @@media (max-width: 991.98px) {
            #modal_ReviewBatch.review-dock-right .modal-dialog {
                width: 100%;
                max-width: 100vw;
            }
        }
    </style>

    @using (Html.BeginForm("ReviewBatch", "ReviewBatchItem", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "ReviewBatch", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_ReviewForm")
        </div>
    }

    <script type="text/javascript">
        // Neo panel rà soát về bên phải màn hình.
        // Khởi tạo với backdrop:false ngay trước khi framework gọi modal("show")
        // để không sinh lớp phủ chặn thao tác với nội dung phía sau.
        $('#modal_ReviewBatch')
            .addClass('review-dock-right')
            .removeClass('modal-lg modal-fs')
            .modal({ backdrop: false, keyboard: true, show: false })
            .on('shown.bs.modal', function () {
                $('body').addClass('review-dock-open');
            })
            .on('hidden.bs.modal', function () {
                $('body').removeClass('review-dock-open');
            });
    </script>

    <script type="text/javascript">
        $('form#ReviewBatch').ajaxForm({
            success: function (response) {
                const formId = "ReviewBatch";
                const $modal = $("#ModalContent #modal_" + formId);
                // validate fail
                if (response.status === undefined) {
                    $modal.find("#bodyForm").html(response);
                    return;
                }
                const processSuccess = () => {
                    eval(response.message);
                    let tab = "project";
                    // opportunity
                    if (response.tab === 1) {
                        tab = "opportunity";
                    }
                    // project
                    if (response.tab === 2) {
                        tab = "project";
                    }
                    // Quay lại đúng đợt rà soát vừa thao tác thay vì danh sách rỗng
                    const batchId = response.reviewBatchID || 0;
                    const backUrl = batchId > 0
                        ? "/Cate/ReviewBatchItem/Index/" + batchId + "?tab=" + tab
                        : "/Cate/ReviewBatchItem?tab=" + tab;
                    window.location.href = backUrl;
                    response.status = undefined;
                };

                const isKeepOpen = $modal.find("#chkNotDismissModal").is(":checked");

                if (isKeepOpen) {
                    processSuccess();
                    const urlAction = $modal.find("form").attr("action");
                    $modal.find("#modal-content")
                        .load(urlAction, function () {
                            _initElement();
                        });
                } else {
                    $modal.off("hidden.bs.modal")
                        .on("hidden.bs.modal", function () {
                            processSuccess();
                        });
                    $modal.modal("hide");
                }
            }
        });
    </script>
}

@section ContinueForm{

}