@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesModel

<div class="modal fade" id="modalEditSales" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content border-0 shadow-lg radius-2 overflow-hidden">
            <div class="modal-header bgc-primary-d1 text-white py-25 px-3">
                <h5 class="modal-title text-110 font-bold">
                    <i class="fa fa-edit mr-1 text-white-tp1"></i> Cập nhật Thông tin Hồ sơ: @Model.Code
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="frmEditSales" method="post" enctype="multipart/form-data">
                <div class="modal-body p-3" id="bodyForm">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.DigitalSalesID)
                    @Html.HiddenFor(m => m.Code)
                    @Html.HiddenFor(m => m.BusinessType)
                    @Html.HiddenFor(m => m.StatusID)

                    <div class="row">
                        <!-- 1. TIÊU ĐỀ VÀ MÃ HỒ SƠ -->
                        <div class="col-md-8 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="Title">
                                <i class="fa fa-tag text-primary mr-1"></i> Tên hồ sơ / Tiêu đề cơ hội <span class="text-danger">(*)</span>
                            </label>
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control form-control-sm", required = "required" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger text-85" })
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="Code">
                                <i class="fa fa-barcode text-secondary mr-1"></i> Mã hồ sơ
                            </label>
                            @Html.TextBoxFor(m => m.Code, new { @class = "form-control form-control-sm bgc-grey-l4 text-secondary-d2 font-mono font-bold", @readonly = "readonly" })
                        </div>

                        <!-- 2. KHÁCH HÀNG / DOANH NGHIỆP -->
                        <div class="col-md-12 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="CustomerID_Edit">
                                <i class="fa fa-building text-primary mr-1"></i> Khách hàng / Doanh nghiệp <span class="text-danger">(*)</span>
                            </label>
                            <input type="hidden" id="CustomerID_Edit" name="CustomerID" value="@Model.CustomerID" />
                            @Html.HiddenFor(m => m.ContactPerson_ID)

                            <div class="input-group">
                                <input type="text" id="CustomerNameDisplay_Edit" class="form-control form-control-sm font-bold text-primary-d2 bgc-grey-l5" 
                                       placeholder="Chưa chọn khách hàng..." readonly="readonly" 
                                       value="@(Model.CustomerID > 0 ? Model.CustomerName : "")" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-sm btn-primary font-bold px-3" onclick="openCustomerLookupModal_Edit();">
                                        <i class="fa fa-search mr-1"></i> Chọn khách hàng
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnClearCustomer_Edit" onclick="clearSelectedCustomer_Edit();" title="Bỏ chọn" style="@(Model.CustomerID > 0 ? "" : "display:none;")">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                            </div>
                            @Html.ValidationMessageFor(m => m.CustomerID, "", new { @class = "text-danger text-85" })

                            <!-- Thẻ tóm tắt thông tin khách hàng được chọn -->
                            <div id="customerInfoCard_Edit" class="card border-1 brc-primary-m3 bgc-primary-l4 radius-1 p-2 mt-2 shadow-sm" style="display: none;"></div>
                        </div>

                        <!-- 3. PHÂN CÔNG AM CHỦ TRÌ -->
                        <div class="col-md-12 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="AssignedEmployeeID">
                                <i class="fa fa-user-shield text-success mr-1"></i> Nhân sự AM chủ trì
                            </label>
                            @Html.DropDownListFor(m => m.AssignedEmployeeID, Model.ListEmployee, "-- Chọn AM chủ trì --", new { @class = "form-control form-control-sm select2" })
                            @Html.HiddenFor(m => m.DepartmentID, new { id = "DepartmentID" })
                        </div>

                        @Html.HiddenFor(m => m.ClosingProbability)
                        @Html.HiddenFor(m => m.StartDate)
                        @Html.HiddenFor(m => m.ExpectedDate)

                        <!-- 4. THÔNG TIN HỢP ĐỒNG (NẾU CÓ) -->
                        <div class="col-md-6 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="ContractID">
                                <i class="fa fa-file-contract text-primary mr-1"></i> Hợp đồng liên quan
                            </label>
                            @Html.DropDownListFor(m => m.ContractID, Model.ListContract, "-- Chọn hợp đồng liên quan --", new { @class = "form-control form-control-sm select2" })
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="ContractNo">
                                <i class="fa fa-receipt text-secondary mr-1"></i> Số hợp đồng / Phụ lục
                            </label>
                            @Html.TextBoxFor(m => m.ContractNo, new { @class = "form-control form-control-sm", placeholder = "Số HĐ / Phụ lục..." })
                        </div>

                        <!-- 5. FILE ĐÍNH KÈM (CHO PHÉP CHỌN NHIỀU FILE) -->
                        <div class="col-md-12 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90">
                                <i class="fa fa-paperclip text-secondary mr-1"></i> File đính kèm
                            </label>
                            @if (!string.IsNullOrEmpty(Model.FileAttach))
                            {
                                var attachedFiles = Model.FileAttach.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries);
                                <div class="mb-2 p-2 bgc-grey-l4 radius-1 border-1 brc-grey-l2">
                                    <div class="text-85 text-secondary font-bold mb-1">
                                        <i class="fa fa-folder-open mr-1 text-primary"></i>Danh sách file hiện có (@attachedFiles.Length file):
                                    </div>
                                    <div class="d-flex flex-wrap">
                                        @foreach (var f in attachedFiles)
                                        {
                                            var fTrim = f.Trim();
                                            var fname = System.IO.Path.GetFileName(fTrim);
                                            <a href="@fTrim" target="_blank" class="badge badge-lg bgc-white border-1 brc-primary-m3 text-primary-d2 mr-2 mb-1 p-2 shadow-xs" title="Bấm để tải file @fname">
                                                <i class="fa fa-download text-primary mr-1"></i>@fname
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                            <input type="file" name="fileUpload" multiple="multiple" class="form-control-file border p-1 rounded bgc-grey-l5" />
                            <small class="text-muted text-85 mt-1 d-block">
                                <i class="fa fa-info-circle text-info mr-1"></i>Có thể chọn cùng lúc <strong>nhiều file mới</strong> để bổ sung (giữ phím <code>Ctrl</code> hoặc <code>Shift</code>).
                            </small>
                        </div>

                        <!-- 6. MÔ TẢ QUA CKEDITOR -->
                        <div class="col-md-12 mb-2">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="DigitalSales_Edit_Note">
                                <i class="fa fa-file-alt text-primary mr-1"></i> Mô tả chi tiết nhu cầu / Ghi chú dịch vụ số
                            </label>
                            @Html.TextAreaFor(m => m.Note, new { @id = "DigitalSales_Edit_Note", @name = "Note", @class = "form-control form-control-sm", rows = "4" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer bgc-grey-l5 py-2 px-3">
                    <button type="button" class="btn btn-sm btn-secondary radius-1 px-3" data-dismiss="modal">
                        <i class="fa fa-times mr-1"></i> Đóng
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary radius-1 px-3">
                        <i class="fa fa-save mr-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL TRA CỨU KHÁCH HÀNG (DÙNG CHO EDIT) -->
<div class="modal fade" id="modalCustomerLookup_Edit" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content border-0 shadow-lg radius-2 overflow-hidden">
            <div class="modal-header bgc-primary-d2 text-white py-2 px-3">
                <h6 class="modal-title font-bold text-white mb-0">
                    <i class="fa fa-search mr-1"></i> Tra cứu và Chọn Khách hàng / Doanh nghiệp
                </h6>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-3">
                <!-- Thanh tìm kiếm -->
                <div class="row mb-3">
                    <div class="col-md-9">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0"><i class="fa fa-search text-primary"></i></span>
                            </div>
                            <input type="text" id="txtSearchCustomerKeyword_Edit" class="form-control border-left-0" 
                                   placeholder="Nhập tên doanh nghiệp, mã số thuế, số điện thoại, địa chỉ để tìm..." />
                        </div>
                    </div>
                    <div class="col-md-3 d-flex">
                        <button type="button" class="btn btn-primary btn-block font-bold" onclick="performCustomerLookup_Edit(1);">
                            <i class="fa fa-search mr-1"></i> Tìm kiếm
                        </button>
                    </div>
                </div>

                <!-- Bảng danh sách kết quả -->
                <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
                    <table class="table table-bordered table-hover table-striped text-90 mb-0" id="tblCustomerLookupResults_Edit">
                        <thead class="bgc-grey-l3 text-secondary-d2">
                            <tr>
                                <th style="width: 45px;" class="text-center">STT</th>
                                <th>Khách hàng / Doanh nghiệp</th>
                                <th style="width: 140px;">Mã số thuế</th>
                                <th style="width: 120px;">Số điện thoại</th>
                                <th>Địa chỉ</th>
                                <th style="width: 90px;" class="text-center">Chọn</th>
                            </tr>
                        </thead>
                        <tbody id="customerLookupTableBody_Edit">
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="fa fa-spinner fa-spin fa-2x text-primary d-block mb-2"></i>Đang tải dữ liệu khách hàng...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Phân trang và tổng số -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-2 border-t-1 brc-grey-l2">
                    <div class="text-85 text-secondary mb-2 mb-md-0" id="customerLookupTotalText_Edit">
                        Hiển thị 0 kết quả
                    </div>
                    <ul class="pagination pagination-sm mb-0" id="customerLookupPagination_Edit"></ul>
                </div>
            </div>
            <div class="modal-footer bgc-grey-l5 py-2 px-3">
                <button type="button" class="btn btn-sm btn-secondary radius-1" data-dismiss="modal">
                    <i class="fa fa-times mr-1"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var _lookupPage_Edit = 1;
    var _lookupPageSize_Edit = 15;

    function openCustomerLookupModal_Edit() {
        $('#modalCustomerLookup_Edit').modal('show');
        $('#txtSearchCustomerKeyword_Edit').val('');
        performCustomerLookup_Edit(1);
    }

    function clearSelectedCustomer_Edit() {
        $('#CustomerID_Edit').val('');
        $('#CustomerNameDisplay_Edit').val('').attr('placeholder', 'Chưa chọn khách hàng...');
        $('#btnClearCustomer_Edit').hide();
        $('#customerInfoCard_Edit').slideUp(200).empty();
        loadContactPersonsByCustomer('', '#modalEditSales #ContactPerson_ID');
    }

    function performCustomerLookup_Edit(page) {
        _lookupPage_Edit = page || 1;
        var keyword = $('#txtSearchCustomerKeyword_Edit').val() || '';
        $('#customerLookupTableBody_Edit').html(
            '<tr><td colspan="6" class="text-center py-4 text-muted"><i class="fa fa-spinner fa-spin fa-2x text-primary d-block mb-2"></i>Đang tìm kiếm...</td></tr>'
        );

        $.get('/Cate/DigitalSales/SearchCustomers', { q: keyword, page: _lookupPage_Edit, pageSize: _lookupPageSize_Edit }, function (res) {
            if (!res || !res.data || res.data.length === 0) {
                $('#customerLookupTableBody_Edit').html(
                    '<tr><td colspan="6" class="text-center py-4 text-muted"><i class="fa fa-building fa-2x text-secondary-l1 d-block mb-2"></i>Không tìm thấy khách hàng nào phù hợp với từ khóa!</td></tr>'
                );
                $('#customerLookupTotalText_Edit').text('Hiển thị 0 kết quả');
                $('#customerLookupPagination_Edit').empty();
                return;
            }

            var rows = '';
            var startIdx = (_lookupPage_Edit - 1) * _lookupPageSize_Edit + 1;
            $.each(res.data, function (idx, c) {
                var cusDataEscaped = encodeURIComponent(JSON.stringify(c));
                rows += '<tr>' +
                    '<td class="text-center">' + (startIdx + idx) + '</td>' +
                    '<td>' +
                        '<div class="font-weight-bold text-primary-d2">' + c.text + '</div>' +
                        (c.shortName ? '<div class="text-80 text-secondary">' + c.shortName + '</div>' : '') +
                    '</td>' +
                    '<td>' + (c.taxCode ? '<span class="badge bgc-secondary-l3 text-secondary-d3 font-mono font-bold">' + c.taxCode + '</span>' : '—') + '</td>' +
                    '<td>' + (c.phone ? '<span class="text-dark font-600">' + c.phone + '</span>' : '—') + '</td>' +
                    '<td class="text-85 text-muted">' + (c.address || '—') + '</td>' +
                    '<td class="text-center">' +
                        '<button type="button" class="btn btn-xs btn-success font-bold px-2 py-1 radius-1" onclick="applySelectedCustomer_Edit(\'' + cusDataEscaped + '\');">' +
                            '<i class="fa fa-check mr-1"></i> Chọn' +
                        '</button>' +
                    '</td>' +
                '</tr>';
            });
            $('#customerLookupTableBody_Edit').html(rows);
            $('#customerLookupTotalText_Edit').text('Hiển thị ' + res.data.length + ' / ' + res.total + ' khách hàng (Trang ' + res.page + '/' + res.totalPages + ')');

            renderLookupPagination_Edit(res.page, res.totalPages);
        });
    }

    function renderLookupPagination_Edit(current, totalPages) {
        var $p = $('#customerLookupPagination_Edit').empty();
        if (totalPages <= 1) return;

        $p.append('<li class="page-item ' + (current === 1 ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0);" onclick="performCustomerLookup_Edit(' + (current - 1) + ')">&laquo;</a></li>');

        var start = Math.max(1, current - 2);
        var end = Math.min(totalPages, current + 2);
        for (var i = start; i <= end; i++) {
            $p.append('<li class="page-item ' + (i === current ? 'active font-bold' : '') + '"><a class="page-link" href="javascript:void(0);" onclick="performCustomerLookup_Edit(' + i + ')">' + i + '</a></li>');
        }

        $p.append('<li class="page-item ' + (current === totalPages ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0);" onclick="performCustomerLookup_Edit(' + (current + 1) + ')">&raquo;</a></li>');
    }

    function applySelectedCustomer_Edit(cusDataJson) {
        try {
            var c = JSON.parse(decodeURIComponent(cusDataJson));
            $('#CustomerID_Edit').val(c.id);
            $('#CustomerNameDisplay_Edit').val(c.text);
            $('#btnClearCustomer_Edit').show();

            $('#customerInfoCard_Edit').html(
                '<div class="d-flex align-items-start">' +
                    '<div class="bgc-primary-m1 text-white p-2 radius-1 mr-2 flex-shrink-0"><i class="fa fa-building fa-lg"></i></div>' +
                    '<div class="flex-grow-1 min-width-0">' +
                        '<div class="font-weight-bold text-primary-d2 text-95">' + c.text + '</div>' +
                        '<div class="text-85 text-secondary mt-1">' +
                            (c.taxCode ? '<span class="mr-3"><i class="fa fa-id-card mr-1"></i>MST: <strong>' + c.taxCode + '</strong></span>' : '') +
                            (c.phone ? '<span><i class="fa fa-phone mr-1"></i>' + c.phone + '</span>' : '') +
                        '</div>' +
                        (c.address ? '<div class="text-80 text-muted mt-1 text-truncate"><i class="fa fa-map-marker-alt text-danger mr-1"></i>' + c.address + '</div>' : '') +
                    '</div>' +
                '</div>'
            ).slideDown(200);

            loadContactPersonsByCustomer(c.id, '#modalEditSales #ContactPerson_ID');
            $('#modalCustomerLookup_Edit').modal('hide');
        } catch (e) {
            console.error("Apply customer error:", e);
        }
    }

    function renderInitialCustomerCard_Edit(cusId) {
        if (cusId && parseInt(cusId) > 0) {
            $.get('/Cate/DigitalSales/GetCustomerDetail', { id: cusId }, function (cus) {
                if (cus) {
                    $('#customerInfoCard_Edit').html(
                        '<div class="d-flex align-items-start">' +
                            '<div class="bgc-primary-m1 text-white p-2 radius-1 mr-2 flex-shrink-0"><i class="fa fa-building fa-lg"></i></div>' +
                            '<div class="flex-grow-1 min-width-0">' +
                                '<div class="font-weight-bold text-primary-d2 text-95">' + cus.customerName + '</div>' +
                                '<div class="text-85 text-secondary mt-1">' +
                                    (cus.taxCode ? '<span class="mr-3"><i class="fa fa-id-card mr-1"></i>MST: <strong>' + cus.taxCode + '</strong></span>' : '') +
                                    (cus.phone ? '<span><i class="fa fa-phone mr-1"></i>' + cus.phone + '</span>' : '') +
                                '</div>' +
                                (cus.address ? '<div class="text-80 text-muted mt-1 text-truncate"><i class="fa fa-map-marker-alt text-danger mr-1"></i>' + cus.address + '</div>' : '') +
                            '</div>' +
                        '</div>'
                    ).slideDown(200);
                }
            });
        }
    }

    (function () {
        var $modal = $('#modalEditSales');

        // 1. Khởi tạo DatePicker
        if ($.fn.datepicker) {
            $modal.find('.date-picker').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true
            });
        }

        // 2. Khởi tạo Select2 cho các ô dropdown thông thường
        if ($.fn.select2) {
            $modal.find('select.select2').select2({
                width: '100%',
                dropdownParent: $modal
            });
        }

        // 2.1 Tự động lấy phòng ban theo AM chủ trì khi thay đổi AM
        $modal.find('#AssignedEmployeeID').on('change', function () {
            var empId = $(this).val();
            if (empId && parseInt(empId) > 0) {
                $.get('/Cate/DigitalSales/GetDepartmentByEmployee', { employeeId: empId }, function (res) {
                    if (res && res.departmentId && parseInt(res.departmentId) > 0) {
                        $modal.find('#DepartmentID').val(res.departmentId);
                    }
                });
            } else {
                $modal.find('#DepartmentID').val('');
            }
        });

        // 3. Xử lý phím Enter trong ô tìm kiếm khách hàng
        $('#txtSearchCustomerKeyword_Edit').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                performCustomerLookup_Edit(1);
            }
        });

        // 4. Giữ cuộn modal cha khi đóng nested modal
        $('#modalCustomerLookup_Edit').on('hidden.bs.modal', function () {
            if ($('#modalEditSales.show').length > 0) {
                $('body').addClass('modal-open');
            }
        });

        // 5. Tải thẻ thông tin khách hàng ban đầu nếu đã có
        var initCusId = $('#CustomerID_Edit').val();
        if (initCusId && parseInt(initCusId) > 0) {
            renderInitialCustomerCard_Edit(initCusId);
        }

        // 6. Khởi tạo CKEditor với cơ chế tự động tải nếu chưa có
        function initEditSalesCKEditor() {
            var ckBasePath = '@Url.Content("~/Contents/Modules/Major/ckeditor4/")';
            window.CKEDITOR_BASEPATH = ckBasePath;

            function createCK() {
                if (typeof CKEDITOR === 'undefined') return;
                if (CKEDITOR.instances['DigitalSales_Edit_Note']) {
                    try { CKEDITOR.instances['DigitalSales_Edit_Note'].destroy(true); } catch (e) { }
                }
                CKEDITOR.replace('DigitalSales_Edit_Note', {
                    customConfig: '',
                    height: 160,
                    toolbar: [
                        { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike'] },
                        { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent'] },
                        { name: 'styles', items: ['Format', 'FontSize'] },
                        { name: 'colors', items: ['TextColor', 'BGColor'] },
                        { name: 'tools', items: ['Maximize'] }
                    ]
                });
            }

            if (typeof CKEDITOR === 'undefined') {
                var ckScript = '@Url.Content("~/Contents/Modules/Major/ckeditor4/ckeditor.js")';
                $.getScript(ckScript, function () {
                    createCK();
                });
            } else {
                createCK();
            }
        }

        setTimeout(initEditSalesCKEditor, 200);

        // 7. Cập nhật CKEditor trước khi submit
        $('#frmEditSales').on('submit', function () {
            if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['DigitalSales_Edit_Note']) {
                CKEDITOR.instances['DigitalSales_Edit_Note'].updateElement();
            }
        });

        // 8. Dọn dẹp CKEditor khi đóng modal
        $modal.on('hidden.bs.modal', function () {
            if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['DigitalSales_Edit_Note']) {
                try { CKEDITOR.instances['DigitalSales_Edit_Note'].destroy(true); } catch (e) { }
            }
        });
    })();
</script>
