@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), "Hồ sơ kinh doanh SPDV Số");
    Layout = "~/Views/Shared/_Form.cshtml";
}
@section FormType {
    primary
}
@section FormIcon {
    <i class="far fa-edit"></i>
}
@section FormBody {
    @using (Html.BeginForm("Edit", "DigitalSales", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "EditDigitalSales", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_DigitalSales", Model)
        </div>
    }

    <script type="text/javascript">
        $('form#EditDigitalSales').ajaxForm({
            beforeSubmit: function () {
                if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['DigitalSales_Form_Note']) {
                    try { CKEDITOR.instances['DigitalSales_Form_Note'].updateElement(); } catch (e) { }
                }
                var cusId = parseInt($('#CustomerID_Form').val()) || parseInt($('form#EditDigitalSales input[name="CustomerID"]').val()) || 0;
                if (cusId <= 0) {
                    $('#bodyForm').find('[data-valmsg-for="CustomerID"]').text('Vui lòng chọn khách hàng!').show();
                }
                return true;
            },
            success: function (response) {
                DigitalSales_OnProcessSuccess(response, "EditDigitalSales");
            },
            error: function () {
                executeResponseMessage("Lỗi kết nối máy chủ!", "Lỗi kết nối máy chủ!", false);
            }
        });
    </script>
}
