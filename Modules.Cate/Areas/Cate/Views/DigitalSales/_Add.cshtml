@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesModel

<div class="modal fade" id="modalAddSales" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content border-0 shadow-lg radius-2 overflow-hidden">
            <div class="modal-header bgc-primary-d1 text-white py-25 px-3">
                <h5 class="modal-title text-110 font-bold">
                    <i class="fa fa-plus-circle mr-1 text-white-tp1"></i> Khởi tạo Cơ hội Kinh doanh Sản phẩm Dịch vụ Số
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="frmAddSales" method="post" enctype="multipart/form-data">
                <div class="modal-body p-3" id="bodyForm">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.BusinessType)
                    @Html.HiddenFor(m => m.StatusID)

                    <div class="alert alert-info py-2 px-3 mb-3 text-90 border-0 radius-1 shadow-sm d-flex align-items-center">
                        <i class="fa fa-info-circle fa-lg text-primary mr-2 flex-shrink-0"></i>
                        <div>
                            Hồ sơ mới mặc định thuộc loại hình <strong>Cơ hội kinh doanh</strong> với trạng thái <strong>Chưa nắm bắt</strong>. Sau khi tiếp cận khách hàng và có thông tin SPDV số, bạn có thể chuyển đổi thành <strong>Dự án</strong>.
                        </div>
                    </div>

                    <div class="row">
                        <!-- 1. TIÊU ĐỀ VÀ MÃ HỒ SƠ -->
                        <div class="col-md-8 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="Title">
                                <i class="fa fa-tag text-primary mr-1"></i> Tên hồ sơ / Tiêu đề cơ hội <span class="text-danger">(*)</span>
                            </label>
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control form-control-sm", placeholder = "Ví dụ: Cung cấp giải pháp Hóa đơn điện tử cho Công ty ABC", required = "required" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger text-85" })
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="Code">
                                <i class="fa fa-barcode text-secondary mr-1"></i> Mã hồ sơ
                            </label>
                            @Html.TextBoxFor(m => m.Code, new { @class = "form-control form-control-sm bgc-grey-l4 text-secondary-d2 font-mono font-bold", placeholder = "Mã hồ sơ tự động sinh", @readonly = "readonly" })
                        </div>

                        <!-- 2. KHÁCH HÀNG / DOANH NGHIỆP -->
                        <div class="col-md-12 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="CustomerID">
                                <i class="fa fa-building text-primary mr-1"></i> Khách hàng / Doanh nghiệp <span class="text-danger">(*)</span>
                            </label>
                            @Html.HiddenFor(m => m.CustomerID, new { id = "CustomerID" })
                            <input type="hidden" name="ContactPerson_ID" id="ContactPerson_ID" value="" />

                            <div class="input-group">
                                <input type="text" id="CustomerNameDisplay" class="form-control form-control-sm font-bold text-primary-d2 bgc-grey-l5" 
                                       placeholder="Chưa chọn khách hàng..." readonly="readonly" 
                                       value="@(Model.CustomerID > 0 ? Model.CustomerName : "")" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-sm btn-primary font-bold px-3" onclick="openCustomerLookupModal();">
                                        <i class="fa fa-search mr-1"></i> Chọn khách hàng
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnClearCustomer" onclick="clearSelectedCustomer();" title="Bỏ chọn" style="@(Model.CustomerID > 0 ? "" : "display:none;")">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                            </div>
                            @Html.ValidationMessageFor(m => m.CustomerID, "", new { @class = "text-danger text-85" })

                            <!-- Thẻ tóm tắt thông tin khách hàng được chọn -->
                            <div id="customerInfoCard" class="card border-1 brc-primary-m3 bgc-primary-l4 radius-1 p-2 mt-2 shadow-sm" style="display: none;"></div>
                        </div>

                        <!-- 3. PHÂN CÔNG AM CHỦ TRÌ -->
                        <div class="col-md-12 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="AssignedEmployeeID">
                                <i class="fa fa-user-shield text-success mr-1"></i> Nhân sự AM chủ trì
                            </label>
                            @Html.DropDownListFor(m => m.AssignedEmployeeID, Model.ListEmployee, "-- Chọn AM chủ trì --", new { @class = "form-control form-control-sm select2" })
                            @Html.HiddenFor(m => m.DepartmentID, new { id = "DepartmentID" })
                        </div>

                        <input type="hidden" name="ClosingProbability" value="50" />

                        <!-- 4. FILE ĐÍNH KÈM (CHO PHÉP CHỌN NHIỀU FILE) -->
                        <div class="col-md-12 mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90">
                                <i class="fa fa-paperclip text-secondary mr-1"></i> File đính kèm (Biên bản tiếp xúc, Yêu cầu KH...)
                            </label>
                            <input type="file" name="fileUpload" multiple="multiple" class="form-control-file border p-1 rounded bgc-grey-l5" />
                            <small class="text-muted text-85 mt-1 d-block">
                                <i class="fa fa-info-circle text-info mr-1"></i>Có thể chọn cùng lúc <strong>nhiều file</strong> (giữ phím <code>Ctrl</code> hoặc <code>Shift</code> khi chọn file).
                            </small>
                        </div>

                        <!-- 5. MÔ TẢ QUA CKEDITOR -->
                        <div class="col-md-12 mb-2">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="DigitalSales_Note">
                                <i class="fa fa-file-alt text-primary mr-1"></i> Mô tả chi tiết nhu cầu / Ghi chú dịch vụ số
                            </label>
                            @Html.TextAreaFor(m => m.Note, new { @id = "DigitalSales_Note", @name = "Note", @class = "form-control form-control-sm", rows = "4", placeholder = "Ghi chú các yêu cầu, nhu cầu dịch vụ số của khách hàng..." })
                        </div>
                    </div>
                </div>

                <div class="modal-footer bgc-grey-l5 py-2 px-3">
                    <button type="button" class="btn btn-sm btn-secondary radius-1 px-3" data-dismiss="modal">
                        <i class="fa fa-times mr-1"></i> Đóng
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary radius-1 px-3">
                        <i class="fa fa-save mr-1"></i> Lưu và mở chi tiết
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL TRA CỨU KHÁCH HÀNG (CUSTOMER LOOKUP MODAL) -->
<div class="modal fade" id="modalCustomerLookup" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content border-0 shadow-lg radius-2 overflow-hidden">
            <div class="modal-header bgc-primary-d2 text-white py-2 px-3">
                <h6 class="modal-title font-bold text-white mb-0">
                    <i class="fa fa-search mr-1"></i> Tra cứu và Chọn Khách hàng / Doanh nghiệp
                </h6>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-3">
                <!-- Thanh tìm kiếm -->
                <div class="row mb-3">
                    <div class="col-md-9">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0"><i class="fa fa-search text-primary"></i></span>
                            </div>
                            <input type="text" id="txtSearchCustomerKeyword" class="form-control border-left-0" 
                                   placeholder="Nhập tên doanh nghiệp, mã số thuế, số điện thoại, địa chỉ để tìm..." />
                        </div>
                    </div>
                    <div class="col-md-3 d-flex">
                        <button type="button" class="btn btn-primary btn-block font-bold" onclick="performCustomerLookup(1);">
                            <i class="fa fa-search mr-1"></i> Tìm kiếm
                        </button>
                    </div>
                </div>

                <!-- Bảng danh sách kết quả -->
                <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
                    <table class="table table-bordered table-hover table-striped text-90 mb-0" id="tblCustomerLookupResults">
                        <thead class="bgc-secondary-l1 text-secondary-d2">
                            <tr>
                                <th style="width: 40px;" class="text-center">STT</th>
                                <th>Khách hàng / Doanh nghiệp</th>
                                <th style="width: 140px;">Mã số thuế</th>
                                <th style="width: 130px;">Số điện thoại</th>
                                <th>Địa chỉ</th>
                                <th style="width: 80px;" class="text-center">Chọn</th>
                            </tr>
                        </thead>
                        <tbody id="customerLookupTableBody">
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="fa fa-spinner fa-spin fa-2x text-primary d-block mb-2"></i>
                                    Đang tải danh sách khách hàng...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Phân trang -->
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-t-1 brc-grey-l2 flex-wrap">
                    <span class="text-secondary text-85" id="customerLookupTotalText">Đang tải...</span>
                    <ul class="pagination pagination-sm mb-0 mt-1" id="customerLookupPagination"></ul>
                </div>
            </div>
            <div class="modal-footer bgc-grey-l5 py-2 px-3">
                <button type="button" class="btn btn-sm btn-secondary radius-1 px-3" data-dismiss="modal">
                    <i class="fa fa-times mr-1"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var _lookupPage = 1;
    var _lookupPageSize = 10;

    function openCustomerLookupModal() {
        $('#modalCustomerLookup').modal('show');
        $('#txtSearchCustomerKeyword').val('');
        performCustomerLookup(1);
    }

    function clearSelectedCustomer() {
        $('#CustomerID').val('');
        $('#CustomerNameDisplay').val('').attr('placeholder', 'Chưa chọn khách hàng...');
        $('#btnClearCustomer').hide();
        $('#customerInfoCard').slideUp(200).empty();
    }

    function performCustomerLookup(page) {
        _lookupPage = page || 1;
        var keyword = $('#txtSearchCustomerKeyword').val() || '';
        $('#customerLookupTableBody').html(
            '<tr><td colspan="6" class="text-center py-4 text-muted"><i class="fa fa-spinner fa-spin fa-2x text-primary d-block mb-2"></i>Đang tìm kiếm...</td></tr>'
        );

        $.get('/Cate/DigitalSales/SearchCustomers', { q: keyword, page: _lookupPage, pageSize: _lookupPageSize }, function (res) {
            if (!res || !res.data || res.data.length === 0) {
                $('#customerLookupTableBody').html(
                    '<tr><td colspan="6" class="text-center py-4 text-muted"><i class="fa fa-building fa-2x text-secondary-l1 d-block mb-2"></i>Không tìm thấy khách hàng nào phù hợp với từ khóa!</td></tr>'
                );
                $('#customerLookupTotalText').text('Hiển thị 0 kết quả');
                $('#customerLookupPagination').empty();
                return;
            }

            var rows = '';
            var startIdx = (_lookupPage - 1) * _lookupPageSize + 1;
            $.each(res.data, function (idx, c) {
                var cusDataEscaped = encodeURIComponent(JSON.stringify(c));
                rows += '<tr>' +
                    '<td class="text-center">' + (startIdx + idx) + '</td>' +
                    '<td>' +
                        '<div class="font-weight-bold text-primary-d2">' + c.text + '</div>' +
                        (c.shortName ? '<div class="text-80 text-secondary">' + c.shortName + '</div>' : '') +
                    '</td>' +
                    '<td>' + (c.taxCode ? '<span class="badge bgc-secondary-l3 text-secondary-d3 font-mono font-bold">' + c.taxCode + '</span>' : '—') + '</td>' +
                    '<td>' + (c.phone ? '<span class="text-dark font-600">' + c.phone + '</span>' : '—') + '</td>' +
                    '<td class="text-85 text-muted">' + (c.address || '—') + '</td>' +
                    '<td class="text-center">' +
                        '<button type="button" class="btn btn-xs btn-success font-bold px-2 py-1 radius-1" onclick="applySelectedCustomer(\'' + cusDataEscaped + '\');">' +
                            '<i class="fa fa-check mr-1"></i> Chọn' +
                        '</button>' +
                    '</td>' +
                '</tr>';
            });
            $('#customerLookupTableBody').html(rows);
            $('#customerLookupTotalText').text('Hiển thị ' + res.data.length + ' / ' + res.total + ' khách hàng (Trang ' + res.page + '/' + res.totalPages + ')');

            renderLookupPagination(res.page, res.totalPages);
        });
    }

    function renderLookupPagination(current, totalPages) {
        var $p = $('#customerLookupPagination').empty();
        if (totalPages <= 1) return;

        $p.append('<li class="page-item ' + (current === 1 ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0);" onclick="performCustomerLookup(' + (current - 1) + ')">&laquo;</a></li>');

        var start = Math.max(1, current - 2);
        var end = Math.min(totalPages, current + 2);
        for (var i = start; i <= end; i++) {
            $p.append('<li class="page-item ' + (i === current ? 'active font-bold' : '') + '"><a class="page-link" href="javascript:void(0);" onclick="performCustomerLookup(' + i + ')">' + i + '</a></li>');
        }

        $p.append('<li class="page-item ' + (current === totalPages ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0);" onclick="performCustomerLookup(' + (current + 1) + ')">&raquo;</a></li>');
    }

    function applySelectedCustomer(cusDataJson) {
        try {
            var c = JSON.parse(decodeURIComponent(cusDataJson));
            $('#CustomerID').val(c.id);
            $('#CustomerNameDisplay').val(c.text);
            $('#btnClearCustomer').show();

            $('#customerInfoCard').html(
                '<div class="d-flex align-items-start">' +
                    '<div class="bgc-primary-m1 text-white p-2 radius-1 mr-2 flex-shrink-0"><i class="fa fa-building fa-lg"></i></div>' +
                    '<div class="flex-grow-1 min-width-0">' +
                        '<div class="font-weight-bold text-primary-d2 text-95">' + c.text + '</div>' +
                        '<div class="text-85 text-secondary mt-1">' +
                            (c.taxCode ? '<span class="mr-3"><i class="fa fa-id-card mr-1"></i>MST: <strong>' + c.taxCode + '</strong></span>' : '') +
                            (c.phone ? '<span><i class="fa fa-phone mr-1"></i>' + c.phone + '</span>' : '') +
                        '</div>' +
                        (c.address ? '<div class="text-80 text-muted mt-1 text-truncate"><i class="fa fa-map-marker-alt text-danger mr-1"></i>' + c.address + '</div>' : '') +
                    '</div>' +
                '</div>'
            ).slideDown(200);

            $('#modalCustomerLookup').modal('hide');
        } catch (e) {
            console.error("Apply customer error:", e);
        }
    }

    (function () {
        var $modal = $('#modalAddSales');

        // 1. DatePicker
        if ($.fn.datepicker) {
            $modal.find('.date-picker').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true
            });
        }

        // 2. Select2 cho các dropdown thông thường
        if ($.fn.select2) {
            $modal.find('select.select2').select2({
                width: '100%',
                dropdownParent: $modal
            });
        }

        // 2.1 Tự động lấy phòng ban theo AM chủ trì khi thay đổi AM
        $modal.find('#AssignedEmployeeID').on('change', function () {
            var empId = $(this).val();
            if (empId && parseInt(empId) > 0) {
                $.get('/Cate/DigitalSales/GetDepartmentByEmployee', { employeeId: empId }, function (res) {
                    if (res && res.departmentId && parseInt(res.departmentId) > 0) {
                        $modal.find('#DepartmentID').val(res.departmentId);
                    }
                });
            } else {
                $modal.find('#DepartmentID').val('');
            }
        });

        // 3. Xử lý phím Enter trong thanh tìm kiếm khách hàng
        $('#txtSearchCustomerKeyword').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                performCustomerLookup(1);
            }
        });

        // 4. Giữ cuộn modal cha khi đóng nested modal
        $('#modalCustomerLookup').on('hidden.bs.modal', function () {
            if ($('#modalAddSales.show, #modalEditSales.show').length > 0) {
                $('body').addClass('modal-open');
            }
        });

        // 5. Khởi tạo CKEditor với cơ chế tự động tải nếu chưa có
        function initAddSalesCKEditor() {
            var ckBasePath = '@Url.Content("~/Contents/Modules/Major/ckeditor4/")';
            window.CKEDITOR_BASEPATH = ckBasePath;

            function createCK() {
                if (typeof CKEDITOR === 'undefined') return;
                if (CKEDITOR.instances['DigitalSales_Note']) {
                    try { CKEDITOR.instances['DigitalSales_Note'].destroy(true); } catch (e) { }
                }
                CKEDITOR.replace('DigitalSales_Note', {
                    customConfig: '',
                    height: 160,
                    toolbar: [
                        { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike'] },
                        { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent'] },
                        { name: 'styles', items: ['Format', 'FontSize'] },
                        { name: 'colors', items: ['TextColor', 'BGColor'] },
                        { name: 'tools', items: ['Maximize'] }
                    ]
                });
            }

            if (typeof CKEDITOR === 'undefined') {
                var ckScript = '@Url.Content("~/Contents/Modules/Major/ckeditor4/ckeditor.js")';
                $.getScript(ckScript, function () {
                    createCK();
                });
            } else {
                createCK();
            }
        }

        setTimeout(initAddSalesCKEditor, 200);

        // 6. Cập nhật CKEditor trước khi submit
        $('#frmAddSales').on('submit', function () {
            if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['DigitalSales_Note']) {
                CKEDITOR.instances['DigitalSales_Note'].updateElement();
            }
        });

        // 7. Dọn dẹp CKEditor khi đóng modal
        $modal.on('hidden.bs.modal', function () {
            if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['DigitalSales_Note']) {
                try { CKEDITOR.instances['DigitalSales_Note'].destroy(true); } catch (e) { }
            }
        });
    })();
</script>
