@model Core.Cate.Models.RM_DigitalSalesProductModel

@using TSFramework.Libs.Processors

<div class="modal fade" id="modalProduct" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header bgc-primary-d1 text-white">
                <h5 class="modal-title text-110">
                    <i class="fa fa-cubes mr-1"></i> @(Model.SalesProductID > 0 ? "Cập nhật Sản phẩm / Dịch vụ số" : "Thêm mới Sản phẩm / Dịch vụ số")
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="frmProductModal" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.SalesProductID)
                    @Html.HiddenFor(m => m.DigitalSalesID)

                    <div class="form-group mb-3">
                        @Html.TitleFor(m => m.ProductServiceID, new { @class = "text-85 text-600 mb-1" })
                        @Html.DropDownListFor(m => m.ProductServiceID, (List<SelectListItem>)ViewBag.ProductList, AppProcessor.Messagor.GetMessage("DigitalSalesProduct_ProductService_Option"), new { @class = "form-control form-control-sm select2", required = "required" })
                    </div>

                    <div class="row">
                        <div class="col-md-7 mb-3">
                            @Html.TitleFor(m => m.PackageName, new { @class = "text-85 text-600 mb-1" })
                            @Html.TextBoxFor(m => m.PackageName, new { @class = "form-control form-control-sm", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesProduct_PackageName_Placeholder") })
                        </div>
                        <div class="col-md-5 mb-3">
                            @Html.TitleFor(m => m.Quantity, new { @class = "text-85 text-600 mb-1" })
                            @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control form-control-sm", type = "number", min = "1", required = "required" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.TitleFor(m => m.ExpectedRevenue, new { @class = "text-85 text-600 mb-1" })
                            @Html.TextBoxFor(m => m.ExpectedRevenue, new { @class = "form-control form-control-sm text-right", placeholder = AppProcessor.Messagor.GetMessage("DigitalSales_Amount_Placeholder"), type = "number", step = "1000" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.TitleFor(m => m.ActualRevenue, new { @class = "text-85 text-600 mb-1" })
                            @Html.TextBoxFor(m => m.ActualRevenue, new { @class = "form-control form-control-sm text-right", placeholder = AppProcessor.Messagor.GetMessage("DigitalSales_Amount_Placeholder"), type = "number", step = "1000" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.TitleFor(m => m.StartDate, new { @class = "text-85 text-600 mb-1" })
                            @Html.TextBoxFor(m => m.StartDate, "{0:dd/MM/yyyy}", new { id = "ProdStartDate", @class = "form-control form-control-sm date-picker", placeholder = AppProcessor.Messagor.GetMessage("DigitalSales_Date_Placeholder"), autocomplete = "off" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.TitleFor(m => m.EndDate, new { @class = "text-85 text-600 mb-1" })
                            @Html.TextBoxFor(m => m.EndDate, "{0:dd/MM/yyyy}", new { id = "ProdEndDate", @class = "form-control form-control-sm date-picker", placeholder = AppProcessor.Messagor.GetMessage("DigitalSales_Date_Placeholder"), autocomplete = "off" })
                        </div>
                    </div>

                    <div class="form-group mb-2">
                        @Html.TitleFor(m => m.Note, new { @class = "text-85 text-600 mb-1" })
                        @Html.TextAreaFor(m => m.Note, 2, 50, new { @class = "form-control form-control-sm" })
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="fa fa-save mr-1"></i> Lưu sản phẩm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
