@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ContactPersonsSearchModel

<div class="Search card dcard border-0 shadow-sm radius-0" id="SearchContactPersons">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>

    <div class="card-body p-2 d-flex align-items-end">

        <!-- Keyword -->
        <div class="Search_Box w-25 keyWord">
            <label class="font-bold text-sm-right">
                @AppProcessor.Messagor.GetMessage("Label_TuKhoa")
            </label>
            <div>
                <input type="text" id="cpKeyword" class="form-control"
                       placeholder="Nhập tên, SĐT,Tên khách hàng, Email..." />
            </div>
        </div>

        <div class="Group">
            <!-- Gender -->
            <div class="Search_Box">
                <label class="font-bold text-sm-right">
                    @AppProcessor.Messagor.GetMessage("ContactPersonal_Gender_Label")
                </label>
                <div class="">
                    @Html.DropDownListFor(m => m.Gender,
                        Model.ListGender,
                        "-- Chọn giới tính --",
                        new { @class = "form-control", id = "cpGender" })
                </div>
            </div>

            <!-- Status -->
            <div class="Search_Box">
                <label class="font-bold text-sm-right">
                    @AppProcessor.Messagor.GetMessage("Label_Status")
                </label>
                <div class="">
                    @Html.DropDownListFor(m => m.Status,
                        Model.ListStatus,
                        "-- Chọn trạng thái --",
                        new { @class = "form-control", id = "cpStatus" })
                </div>
            </div>
        </div>

        <div class="Group Group_button">
            <div class="Search_button">
                <button type="button" class="btn btn-primary" onclick="SearchContactPersons()">
                    <i class="fa fa-search"></i> &nbsp;Tìm kiếm
                </button>
            </div>

            <div class="Search_button">
                <button type="button" id="btnExportContactPersons" class="btn btn-warning ml-2">
                    <i class="fa fa-download"></i> &nbsp;@AppProcessor.Messagor.GetMessage("Button_Export_ContactPersons")
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#SearchContactPersons').on('keydown', 'input, select', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                SearchContactPersons();
            }
        });
        $('#SearchContactPersons').on('change', 'select', function () {
            SearchContactPersons();
        });
    });
</script>