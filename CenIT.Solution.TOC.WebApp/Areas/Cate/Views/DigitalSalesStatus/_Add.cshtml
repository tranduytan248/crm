@using TSFramework.Libs.Processors
@{ ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("DigitalSalesStatus_Title")); Layout = "~/Views/Shared/_Form.cshtml"; }
@section FormType { primary }
@section FormIcon { <i class="fa fa-plus"></i> }
@section FormBody {
    @using (Ajax.BeginForm("Add", "DigitalSalesStatus", new { area = "Cate" }, new AjaxOptions { HttpMethod = "POST", OnSuccess = "DigitalSalesStatus_OnProcessSuccess(data, 'AddDigitalSalesStatus')" }, new { @class = "form-horizontal", id = "AddDigitalSalesStatus" })) { <div id="bodyForm">@Html.Partial("_Status")</div> }
}
@section ContinueForm { }
