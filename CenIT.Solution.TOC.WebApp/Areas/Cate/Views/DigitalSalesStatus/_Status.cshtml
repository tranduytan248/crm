@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesStatusModel
@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.StatusID)
<div class="form-group row">
    @Html.TitleFor(m => m.BusinessType, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-sm-8">
        @Html.DropDownListFor(m => m.BusinessType, new[] { new SelectListItem { Value = "1", Text = "Cơ hội" }, new SelectListItem { Value = "2", Text = "Dự án" } }, "-- Chọn loại hình --", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.BusinessType, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(m => m.StatusCode, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-sm-8">@Html.TextBoxFor(m => m.StatusCode, new { @class = "form-control text-uppercase", maxlength = "50", placeholder = "Ví dụ: APPROACHING" })@Html.ValidationMessageFor(m => m.StatusCode, "", new { @class = "text-danger" })</div>
</div>
<div class="form-group row">
    @Html.TitleFor(m => m.StatusName, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-sm-8">@Html.TextBoxFor(m => m.StatusName, new { @class = "form-control", maxlength = "250", placeholder = "Nhập tên trạng thái" })@Html.ValidationMessageFor(m => m.StatusName, "", new { @class = "text-danger" })</div>
</div>
<div class="form-group row">
    @Html.TitleFor(m => m.Description, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-sm-8">@Html.TextAreaFor(m => m.Description, 3, 1, new { @class = "form-control", maxlength = "1000", placeholder = "Mô tả mục đích sử dụng" })@Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })</div>
</div>
<div class="form-group row">
    @Html.TitleFor(m => m.SortOrder, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-sm-3">@Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number", min = "0", step = "1" })@Html.ValidationMessageFor(m => m.SortOrder, "", new { @class = "text-danger" })</div>
    <div class="col-sm-5 pt-2">
        <label class="mr-4">@Html.CheckBoxFor(m => m.IsDefault) @Html.LabelFor(m => m.IsDefault, new { @class = "font-bold mb-0" })</label>
        <label>@Html.CheckBoxFor(m => m.IsActive) @Html.LabelFor(m => m.IsActive, new { @class = "font-bold mb-0" })</label>
        @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger d-block" })
    </div>
</div>
<div class="alert bgc-info-l4 border-0 text-dark-m2 py-2 mb-0"><i class="fa fa-info-circle text-info mr-1"></i>Mỗi loại hình chỉ có một trạng thái mặc định. Chọn mục này sẽ tự bỏ mặc định ở trạng thái cũ.</div>
