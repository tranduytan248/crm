@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesSearchModel

<div class="Search search-opportunity card mb-3" id="SearchDigitalSales">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>
    <div class="card-body p-2 d-flex align-items-end flex-wrap">
        @Html.HiddenFor(model => model.CustomerID, new { id = "CustomerID" })

        <div class="Search_Box keyWord w-50">
            <label class="font-bold text-sm-right">
                @AppProcessor.Messagor.GetMessage("Label_TuKhoa")
            </label>
            @Html.TextBoxFor(model => model.Keyword, new { @class = "form-control", id = "Keyword", placeholder = "Tìm kiếm theo mã, tên hồ sơ, tên khách hàng, tên nhân viên" })
        </div>

        <div class="Search_Box">
            <label class="font-bold text-sm-right">
                Loại hình
            </label>
            <div>
                <select id="BusinessType" name="BusinessType" class="form-control">
                    <option value="">-- Tất cả loại hình --</option>
                    <option value="1" @(Model.BusinessType == 1 ? "selected" : "")>Cơ hội kinh doanh</option>
                    <option value="2" @(Model.BusinessType == 2 ? "selected" : "")>Dự án</option>
                </select>
            </div>
        </div>

        <div class="Search_Box">
            <label class="font-bold text-sm-right">
                Trạng thái
            </label>
            <div>
                @Html.DropDownListFor(model => model.StatusID, Model.ListStatus, "-- Chọn trạng thái --", new { @class = "form-control", id = "StatusID" })
            </div>
        </div>

        <div class="Search_Box Dropdown">
            <label class="font-bold">@AppProcessor.Messagor.GetMessage("Department_Search_Label")</label>
            @Html.DropDownListFor(model => model.DepartmentID, Model.ListDepartment, "-- Chọn phòng --", new { @class = "form-control", id = "DepartmentID" })
        </div>

        <div class="Search_Box Dropdown">
            <label class="font-bold">@AppProcessor.Messagor.GetMessage("Employee_Search_Label")</label>
            @Html.DropDownListFor(model => model.EmployeeID, Model.ListEmployee, "-- Chọn nhân viên --", new { @class = "form-control", id = "EmployeeID" })
        </div>

        <div class="d-flex">
            <div class="Search_Box">
                <label class="font-bold text-sm-right">
                    Từ ngày
                </label>
                <div class="input-group date" id="dpFromDate" style="width: 135px">
                    <input type="text" id="FromDate" name="FromDate" class="form-control" placeholder="dd/mm/yyyy" autocomplete="off" />
                    <div class="input-group-append">
                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    </div>
                </div>
            </div>

            <div class="Search_Box">
                <label class="font-bold text-sm-right">
                    Đến ngày
                </label>
                <div class="input-group date" id="dpToDate" style="width: 135px">
                    <input type="text" id="ToDate" name="ToDate" class="form-control" placeholder="dd/mm/yyyy" autocomplete="off" />
                    <div class="input-group-append">
                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="Group Group_button" style="padding-top: 10px; padding-left: 5px;">
            <div class="Search_button">
                <button type="button" class="btn btn-primary" onclick="reloadSalesTable();" style="width: 110px">
                    <i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>

            <div class="Search_button">
                <button type="button" style="width: 100px" class="btn btn-default btn-outline-secondary ml-2" onclick="resetSalesSearch();">
                    <i class="fa fa-undo"></i>&nbsp;Đặt lại
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        if ($.fn.datepicker) {
            $('#dpFromDate').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'vi'
            });
            $('#dpToDate').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'vi'
            });
        }

        $('#SearchDigitalSales').on('keydown', 'input, select', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                reloadSalesTable();
            }
        });

        $('#SearchDigitalSales').on('change', 'select:not(#DepartmentID)', function () {
            reloadSalesTable();
        });

        // Load danh sách nhân sự phụ trách (AM) theo phòng ban thuộc TTKDGP
        $('#DepartmentID').change(function () {
            var departmentId = $(this).val();
            var $employee = $('#EmployeeID');

            $employee.empty().append('<option value="">-- Chọn nhân viên --</option>');

            $.get('/Cate/DigitalSales/GetEmployeesByDepartment', {
                departmentId: departmentId ? departmentId : 0
            }, function (data) {
                if (data && data.length > 0) {
                    $.each(data, function (i, item) {
                        $employee.append(
                            $('<option>').val(item.Value).text(item.Text)
                        );
                    });
                }
                reloadSalesTable();
            });
        });
    });
</script>

<style>
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-left.datepicker-orient-bottom,
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-right.datepicker-orient-bottom,
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-left.datepicker-orient-top,
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-right.datepicker-orient-top,
    .datepicker.datepicker-dropdown {
        z-index: 1060 !important;
    }
</style>
