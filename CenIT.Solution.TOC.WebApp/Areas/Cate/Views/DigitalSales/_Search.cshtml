@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesSearchModel

<div class="Search search-opportunity card mb-3" id="SearchDigitalSales">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>
    <div class="card-body p-2 d-flex align-items-end flex-wrap">
        @Html.HiddenFor(model => model.CustomerID, new { id = "CustomerID" })

        <div class="Search_Box keyWord w-50">
            @Html.TitleFor(model => model.Keyword, new { @class = "font-bold text-sm-right" })
            @Html.TextBoxFor(model => model.Keyword, new { @class = "form-control", id = "Keyword", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Keyword_Placeholder") })
        </div>

        <div class="Search_Box">
            @Html.TitleFor(model => model.BusinessType, new { @class = "font-bold text-sm-right" })
            <div>
                <select id="BusinessType" name="BusinessType" class="form-control">
                    <option value="">@AppProcessor.Messagor.GetMessage("DigitalSalesSearch_BusinessType_AllOption")</option>
                    <option value="1" @(Model.BusinessType == 1 ? "selected" : "")>@AppProcessor.Messagor.GetMessage("DigitalSales_BusinessType_Opportunity")</option>
                    <option value="2" @(Model.BusinessType == 2 ? "selected" : "")>@AppProcessor.Messagor.GetMessage("DigitalSales_BusinessType_Project")</option>
                </select>
            </div>
        </div>

        <div class="Search_Box">
            @Html.TitleFor(model => model.StatusID, new { @class = "font-bold text-sm-right" })
            <div>
                @Html.DropDownListFor(model => model.StatusID, Model.ListStatus, AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Status_Option"), new { @class = "form-control", id = "StatusID" })
            </div>
        </div>

        <div class="Search_Box Dropdown">
            @Html.TitleFor(model => model.DepartmentID, new { @class = "font-bold" })
            @Html.DropDownListFor(model => model.DepartmentID, Model.ListDepartment, AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Department_Option"), new { @class = "form-control", id = "DepartmentID" })
        </div>

        <div class="Search_Box Dropdown">
            @Html.TitleFor(model => model.EmployeeID, new { @class = "font-bold" })
            @Html.DropDownListFor(model => model.EmployeeID, Model.ListEmployee, AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Employee_Option"), new { @class = "form-control", id = "EmployeeID" })
        </div>

        <div class="d-flex">
            <div class="Search_Box">
                @Html.TitleFor(model => model.FromDate, new { @class = "font-bold text-sm-right" })
                <div class="input-group date" id="dpFromDate" style="width: 135px">
                    @Html.TextBoxFor(model => model.FromDate, new { @class = "form-control", id = "FromDate", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Date_Placeholder"), autocomplete = "off" })
                    <div class="input-group-append">
                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    </div>
                </div>
            </div>

            <div class="Search_Box">
                @Html.TitleFor(model => model.ToDate, new { @class = "font-bold text-sm-right" })
                <div class="input-group date" id="dpToDate" style="width: 135px">
                    @Html.TextBoxFor(model => model.ToDate, new { @class = "form-control", id = "ToDate", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Date_Placeholder"), autocomplete = "off" })
                    <div class="input-group-append">
                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="Group Group_button d-inline-flex align-items-center flex-nowrap" style="padding-top: 10px; padding-left: 5px; flex-shrink: 0;">
            <div class="Search_button mr-2">
                <button type="button" class="btn btn-primary text-nowrap" onclick="reloadSalesTable();" style="min-width: 105px; width: auto; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="fa fa-search-plus mr-1"></i>@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>

            <div class="Search_button mr-2">
                <button type="button" class="btn btn-default btn-outline-secondary text-nowrap" onclick="resetSalesSearch();" style="min-width: 95px; width: auto; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="fa fa-undo mr-1"></i>Đặt lại
                </button>
            </div>

            <div class="Search_button">
                <button type="button" class="btn btn-warning font-bold text-nowrap shadow-sm" id="btnExportDigitalSales" onclick="exportDigitalSales();" style="min-width: 140px; width: auto; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; padding: 2px 14px;" title="Tải danh sách theo điều kiện tìm kiếm">
                    <i class="fa fa-download mr-1"></i>Tải danh sách
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function loadStatusesByBusinessType(businessType, selectedStatusId) {
        var $status = $('#StatusID, #SearchStatusID');
        var currentVal = selectedStatusId !== undefined ? selectedStatusId : $status.val();

        $status.empty().append('<option value="">-- Chọn trạng thái --</option>');

        $.get('/Cate/DigitalSales/GetStatusesByBusinessType', {
            businessType: businessType ? businessType : ''
        }, function (data) {
            if (data && data.length > 0) {
                var hasCurrentVal = false;
                $.each(data, function (i, item) {
                    var isSelected = (currentVal && item.id == currentVal);
                    if (isSelected) hasCurrentVal = true;
                    $status.append(
                        $('<option>').val(item.id).text(item.name).prop('selected', isSelected)
                    );
                });
                if (!hasCurrentVal) {
                    $status.val('');
                }
            } else {
                $status.val('');
            }
            $status.trigger("chosen:updated");
            if ($.fn.select2) {
                $status.trigger("change.select2");
            }
            if (typeof reloadSalesTable === 'function') {
                reloadSalesTable();
            }
        });
    }
    window.loadStatusesByBusinessType = loadStatusesByBusinessType;

    $(document).ready(function () {
        if ($.fn.datepicker) {
            $('#dpFromDate').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'vi'
            });
            $('#dpToDate').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'vi'
            });
        }

        $('#SearchDigitalSales').on('keydown', 'input, select', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (typeof reloadSalesTable === 'function') {
                    reloadSalesTable();
                }
            }
        });

        $('#SearchDigitalSales').on('change', 'select:not(#DepartmentID):not(#BusinessType)', function () {
            if (typeof reloadSalesTable === 'function') {
                reloadSalesTable();
            }
        });

        // Load danh sách trạng thái theo Loại hình (Cơ hội kinh doanh / Dự án)
        $('#BusinessType').change(function () {
            var businessType = $(this).val();
            loadStatusesByBusinessType(businessType);
        });

        // Load danh sách nhân sự phụ trách (AM) theo phòng ban thuộc TTKDGP
        $('#DepartmentID').change(function () {
            var departmentId = $(this).val();
            var $employee = $('#EmployeeID');

            $employee.empty().append('<option value="">-- Chọn nhân viên --</option>');

            $.get('/Cate/DigitalSales/GetEmployeesByDepartment', {
                departmentId: departmentId ? departmentId : 0
            }, function (data) {
                if (data && data.length > 0) {
                    $.each(data, function (i, item) {
                        $employee.append(
                            $('<option>').val(item.Value).text(item.Text)
                        );
                    });
                }
                $employee.trigger("chosen:updated");
                if ($.fn.select2) {
                    $employee.trigger("change.select2");
                }
                if (typeof reloadSalesTable === 'function') {
                    reloadSalesTable();
                }
            });
        });
    });
</script>

<style>
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-left.datepicker-orient-bottom,
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-right.datepicker-orient-bottom,
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-left.datepicker-orient-top,
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-right.datepicker-orient-top,
    .datepicker.datepicker-dropdown {
        z-index: 1060 !important;
    }
</style>
