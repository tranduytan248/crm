@using TSFramework.Libs.Processors
@{ ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("DigitalSalesProcess_Title")); Layout = "~/Views/Shared/_Form.cshtml"; }
@section FormType { warning }
@section FormIcon { <i class="far fa-edit"></i> }
@section FormBody { @using (Ajax.BeginForm("Edit", "DigitalSalesProcess", new { area = "Cate" }, new AjaxOptions { HttpMethod = "POST", OnSuccess = "DigitalSalesProcess_OnProcessSuccess(data, 'EditDigitalSalesProcess')" }, new { @class = "form-horizontal", id = "EditDigitalSalesProcess" })) { <div id="bodyForm">@Html.Partial("_Process")</div> } }
