@model Core.Cate.Models.RM_DigitalSalesProgressPageModel
@{ ViewBag.Title = "Tiến trình mẫu — " + Model.Process.ProcessName; Layout = "~/Views/Shared/_Form.cshtml"; }
@section FormType { primary }
@section FormIcon { <i class="fa fa-list-ol"></i> }
@section FormBody {
<div id="digitalProgressManager" data-process-id="@Model.Process.ProcessID">
    <div class="alert bgc-info-l4 border-0 text-dark-m2 py-2"><strong>@Model.Process.BusinessTypeName / @Model.Process.StatusName</strong><span class="mx-2">•</span>@Model.Process.ProcessCode</div>
    <form id="digitalProgressForm" class="border rounded p-3 mb-3 bgc-secondary-l4">
        @Html.AntiForgeryToken()
        <input type="hidden" id="ProgressID" name="ProgressID" value="0" /><input type="hidden" name="ProcessID" value="@Model.Process.ProcessID" />
        <div class="row">
            <div class="col-md-3"><label class="font-bold" for="ProgressCode">Mã tiến trình <span class="text-danger">*</span></label><input class="form-control text-uppercase" id="ProgressCode" name="ProgressCode" maxlength="50" required /></div>
            <div class="col-md-5 mt-3 mt-md-0"><label class="font-bold" for="ProgressName">Tên tiến trình <span class="text-danger">*</span></label><input class="form-control" id="ProgressName" name="ProgressName" maxlength="250" required /></div>
            <div class="col-md-2 mt-3 mt-md-0"><label class="font-bold" for="ProgressSortOrder">Thứ tự</label><input class="form-control" id="ProgressSortOrder" name="SortOrder" type="number" min="0" value="1" required /></div>
            <div class="col-md-2 mt-3 mt-md-0 pt-md-4"><label><input id="ProgressIsActive" name="IsActive" type="checkbox" value="true" checked /><input name="IsActive" type="hidden" value="false" /> <strong>Kích hoạt</strong></label></div>
        </div>
        <div class="row mt-3"><div class="col-md-10"><label class="font-bold" for="ProgressDescription">Mô tả</label><textarea class="form-control" id="ProgressDescription" name="Description" rows="2" maxlength="1000"></textarea></div><div class="col-md-2 d-flex align-items-end mt-3 mt-md-0"><button id="btnSaveDigitalProgress" type="submit" class="btn btn-primary btn-block"><i class="fa fa-save mr-1"></i>Lưu</button></div></div>
        <div id="digitalProgressErrors" class="text-danger mt-2" role="alert"></div>
    </form>
    <div class="table-responsive"><table class="table table-hover border" id="digitalProgressTable"><thead class="bgc-secondary-l1 text-uppercase text-85"><tr><th style="width:60px">STT</th><th>Mã</th><th>Tên tiến trình</th><th>Mô tả</th><th style="width:80px">Thứ tự</th><th style="width:90px">Kích hoạt</th><th style="width:120px">Thao tác</th></tr></thead><tbody></tbody></table></div>
    <div id="digitalProgressEmpty" class="text-center text-secondary py-4 d-none"><i class="fa fa-inbox fa-2x mb-2 d-block"></i>Chưa có tiến trình mẫu. Hãy thêm tiến trình đầu tiên ở biểu mẫu phía trên.</div>
</div>
}
@section SubmitControl { }
@section BottomScript { <script>DigitalSalesProgress_Init();</script> }
