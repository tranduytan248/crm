@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_BannerModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Banners_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Banners", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Banners_OnProcessSuccess(data, 'DeleteBanners')"
    }, new { @class = "form-horizontal", id = "DeleteBanners" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.BannerId)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}