@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Report_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
}

<link rel="stylesheet" type="text/css" href="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/tiny-date-picker.css">
<link rel="stylesheet" type="text/css" href="~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/css/bootstrap-select.css">

@Html.Partial("_Search")

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSServiceRequests" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="w1pc">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ServiceRequest_DateFromLabel")</th>
                        <th>@AppProcessor.Messagor.GetMessage("RequesterInfo_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("StatusProcess_Title")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/dist/date-range-picker.js"></script>
    <script src="@Url.Content("~/Areas/Cate/Views/Report/Report.js")"></script>
}