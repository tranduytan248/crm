@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_FAQModel
@Html.HiddenFor(model => model.Id)
@Html.AntiForgeryToken()
<div class="form-group row">
    @Html.TitleFor(model => model.Question, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-9">
        @Html.TextAreaFor(model => model.Question, new { @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("Question_Label") })
        @Html.ValidationMessageFor(model => model.Question, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.Answer, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-9">
        @Html.TextAreaFor(model => model.Answer, new { @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("Answer_Label") })
        @Html.ValidationMessageFor(model => model.Answer, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.SortOrder, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-9">
        @Html.TextBoxFor(model => model.SortOrder, new { @class = "form-control col-md-2", type = "number", placeholder = AppProcessor.Messagor.GetMessage("HeadMenu_Position") })
        @Html.ValidationMessageFor(model => model.SortOrder, "", new { @class = "text-danger" })
    </div>
</div>
<script>
    $(document).ready(function () {
        document.querySelector('#Question').addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = `${this.scrollHeight}px`;
        });
        document.querySelector('#Answer').addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = `${this.scrollHeight}px`;
        });

        setTimeout(function () {
            document.querySelector('#Question').style.height = document.querySelector('#Question').scrollHeight + 'px';
            document.querySelector('#Answer').style.height = document.querySelector('#Answer').scrollHeight + 'px';
        }, 300);
    });
</script>