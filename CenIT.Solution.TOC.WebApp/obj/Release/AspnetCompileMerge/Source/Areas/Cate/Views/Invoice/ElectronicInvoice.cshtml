<!-- 1. Thêm một wrapper bọc toàn bộ trang -->
<div class="invoice-wrapper">
    <!-- Nút tải PDF cố định bên phải màn hình -->
    <div class="fixed-download-btn">
        <form method="get" action="@Url.Action("DownloadPDF", "Invoice")">
            <input type="hidden" name="contractcode" value="@contractCode" />
            <input type="hidden" name="period" value="@period" />
            <input type="hidden" name="checksum" value="@checksum" />
            <button type="submit" class="btn primary"><i class="fa fa-download"></i> Tải PDF</button>
        </form>
    </div>
    <!-- Hóa đơn gốc (giữ nguyên 790px) -->
    <div id="invoice-scale">
        <div id="ElInvView">
            @Html.Raw(Model.htmlElectronicInvoice)
        </div>
    </div>
</div>
    <script>
        setTimeout(
            hidePhuginChrome, 300
        )
        function hidePhuginChrome() {
            $("#4plugin").addClass("d-none");
        }

        $("#pdfForm").on("submit", function (e) {
            e.preventDefault();
            this.submit();
        });
    </script>

