@using TSFramework.Libs.Processors
@model Core.Cate.Models.KWC_Notification_ContractRegisterReceiveEmailModel

@{
    ViewBag.Title = "Gửi thông báo tiền cước cho tất cả các hợp đồng";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    warning
}

@section FormBody{
    @using (Ajax.BeginForm("SendNotificationEmailAllDevice", "NotificationByEmail", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Notification_OnProcessSuccess(data, 'SendNotificationEmailAllDevice')"
    }, new { @class = "form-horizontal", id = "SendNotificationEmailAllDevice" }))
    {
        @Html.AntiForgeryToken()   
        @Html.HiddenFor(model => model.Period)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}