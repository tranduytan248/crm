@model Core.Cate.Models.Cate_CustomerModel

@{
    ViewBag.Title = $"Reset mật khẩu cho tài khoản - [{Model.FullName} - {Model.Username}]";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    warning
}

@section FormBody{
    @using (Ajax.BeginForm("ResetPassword", "Customer", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Customer_OnProcessSuccess(data, 'ResetPassword')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CustomerId)
        @Html.HiddenFor(model => model.FullName)
        @Html.HiddenFor(model => model.Username)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}