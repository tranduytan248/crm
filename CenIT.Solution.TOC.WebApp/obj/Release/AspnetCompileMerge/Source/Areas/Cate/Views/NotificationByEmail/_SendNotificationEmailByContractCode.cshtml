@using TSFramework.Libs.Processors
@model Core.Cate.Models.KWC_Notification_ContractRegisterReceiveEmailModel

@{
    ViewBag.Title = "Gửi thông báo tiền cước";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    warning
}

@section FormBody{
    @using (Ajax.BeginForm("SendNotificationEmailByContractCode", "NotificationByEmail", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Notification_OnProcessSuccess(data, 'SendNotificationEmailByContractCode')"
    }, new { @class = "form-horizontal", id = "SendNotificationEmailByContractCode" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ContractCode)     
        @Html.HiddenFor(model => model.Period)
        @Html.HiddenFor(model => model.Amount)
        @Html.HiddenFor(model => model.Account_ID)
        @Html.HiddenFor(model => model.CustomerName)
        @Html.HiddenFor(model => model.Email)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}