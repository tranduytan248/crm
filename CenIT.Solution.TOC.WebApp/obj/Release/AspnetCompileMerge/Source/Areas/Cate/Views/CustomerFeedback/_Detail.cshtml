@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_CustomerFeedbackModel
@{
    ViewBag.Title = "Chi tiết " + AppProcessor.Messagor.GetMessage("CustomerFeedback_Title").ToLower() + " - [" + Model.CodeFeedback + "]";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    warning
}

@section FormIcon{
    <i class="fas fa-eye"></i>
}

@section FormBody{
    <div class="card dcard mb-2">
        <div class="card-header bgc-pink-l5">
            <h5 class="card-title text-120 text-pink text-600">
                Thông tin @AppProcessor.Messagor.GetMessage("CustomerFeedback_Title").ToLower()
            </h5>
        </div><!-- /.card-header -->
        <div class="card-body p-0 collapse show">
            <div class="col-12 px-4 mt-3">
                <div class="mt-2 text-dark-m3 d-flex">
                    <i class="text-130 fas fa-user pos-rel text-center pt-2 mx-2px w-5 h-5 border-1 brc-white radius-round bgc-success text-white"></i>
                    <div class="ml-2">
                        <div>
                            <a href="javascript:void(0);" class="text-130 btn-text-blue btn-h-text-pink">@Model.FullName</a>
                            <span class="text-secondary text-600 font-italic">(SĐT: @Model.PhoneNumber - Email: @Model.Email)</span>
                        </div>
                        <div>
                            <div class="text-secondary text-85 font-italic"><i class=" far fa-clock"></i> Gửi lúc: @Model.SubmitDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
                        </div>
                    </div>
                </div>
                <div class="mb-2 text-95 pl-3">
                    <div class="text-95 text-danger-d4"><i class=" fas fa-code"></i> Mã ý kiến: @Model.CodeFeedback</div>
                    <div class="text-95 text-blue"><i class=" fas fa-tag"></i> Chủ đề: @Model.NameCategory</div>
                    <div class="text-120 text-600 text-dark-l4">@Model.Title</div>
                    <div class="pt-2 mt-sm-0 flex-grow-1 text-dark-m2">
                        <p class="mb-1">
                            @Model.Content.Replace("\r\n", "</br>")
                        </p>
                        @if (!string.IsNullOrEmpty(Model.AttachmentUrl))
                        {
                            <div class=""><span class="text-secondary"> Đính kèm: </span><a href="@Model.AttachmentUrl" class="btn-text-blue btn-h-text-warning">@Path.GetFileName(Model.AttachmentUrl)</a></div>
                        }
                    </div>
                </div>
            </div>
        </div><!-- /.card-body -->
    </div>
    @if (Model.StatusFeedback == 1)
    {
        <div class="card dcard">
            <div class="card-header bgc-blue-l5">
                <h5 class="card-title text-120 text-blue text-600">
                    Thông tin phản hồi
                </h5>
            </div><!-- /.card-header -->
            <div class="card-body p-0 collapse show">
                <div class="col-12 px-4 mt-3">
                    <div class="mt-2 text-dark-m3 d-flex">
                        <i class="text-130 fas fa-user-tie pos-rel text-center pt-2 mx-2px w-5 h-5 border-1 brc-white radius-round bgc-orange text-white"></i>
                        <div class="ml-2">
                            <div>
                                <a href="javascript:void(0);" class="text-130 btn-text-blue btn-h-text-blue">@Model.ProcessedBy</a>
                            </div>
                            <div>
                                <div class="text-secondary text-85 font-italic"><i class=" far fa-clock"></i> Gửi lúc: @Model.ProcessedDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2 text-95 pl-3">
                        <div class="pt-2 mt-sm-0 flex-grow-1 text-dark-m2">
                            <p class="mb-1">
                                @Model.ProcessNote.Replace("\r\n", "</br>")
                            </p>
                        </div>
                    </div>
                </div>
            </div><!-- /.card-body -->
        </div>
    }
    <script>
        $('#modal_Detail .modal-footer').addClass('d-none');
    </script>
}

@section ContinueForm{

}