@model Core.Cate.Models.Cate_CustomerFeedbackModel
@Html.ValidationMessage("CaptchaInputText", "", new { @class = "text-danger d-none" })

@Html.AntiForgeryToken()
<div class="">
    <div class="title_template">Thông tin hiện tại</div>
    <!--mã KH-->
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.TextBoxFor(m => m.AccountUser, new { @readonly = "", @class = "form-control shadow-none radius-5", placeholder = "" })
        @Html.TitleFor(model => model.AccountUser, new { @class = "floating-label " })
    </div>
    <!--Mã HĐ-->
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.TextBoxFor(m => m.FullName, new { @readonly = "", @class = "form-control shadow-none radius-5", placeholder = "" })
        @Html.TitleFor(model => model.FullName, new { @class = "floating-label " })
    </div>
    <!--Địa chỉ-->
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.TextAreaFor(m => m.AddressUser, new { @readonly = "", @class = "form-control shadow-none radius-5", placeholder = "" })
        @Html.TitleFor(model => model.AddressUser, new { @class = "floating-label " })
    </div>

    <div class="row mx-auto">
        <div class="col-5 pl-0 pr-1">
            <!--Số điện thoại-->
            <div class="input-floating-label brc-blue-m1 mt-3">
                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control shadow-none radius-5", placeholder = "", @onfocus = "$(\"#PhoneNumber\").inputmask(\"9999999999\");" })
                @Html.TitleFor(model => model.PhoneNumber, new { @class = "floating-label " })
            </div>
            @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
        </div>
        <div class="col-7 pl-1 pr-0">
            <!--Email-->
            <div class="input-floating-label brc-blue-m1 mt-3   ">
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control shadow-none radius-5", placeholder = "", @onfocus = "$(\"#Email\").inputmask(\"email\");" })
                @Html.TitleFor(model => model.Email, new { @class = "floating-label " })
            </div>
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>
    </div>

</div>

<div class="">
    <div class="title_template">Thông tin phản ánh, kiến nghị</div>
    <!--Danh mục-->
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.DropDownListFor(model => model.CategoryFeedbackID, new SelectList(Model.lstCategoryFeedback, "Value", "Text"), "", new { @class = "form-control shadow-none radius-5" })
        @Html.TitleFor(model => model.CategoryFeedbackID, new { @class = "floating-label " })
    </div>
    @Html.ValidationMessageFor(model => model.CategoryFeedbackID, "", new { @class = "text-danger" })


    <!--Tiêu đề -->
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control shadow-none radius-5", placeholder = "" })
        @Html.TitleFor(model => model.Title, new { @class = "floating-label " })
    </div>
    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })

    <!--Nội dung -->
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.TextAreaFor(m => m.Content, new { @class = "form-control shadow-none radius-5", placeholder = "" })
        @Html.TitleFor(model => model.Content, new { @class = "floating-label " })
    </div>
    @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })


    <div class="ml-2 mt-3">Đính kèm (nếu có)</div>
    @Html.ValidationMessageFor(model => model.AttachmentUrl, "", new { @class = "text-danger" })
</div>
@Html.RenderScripts(ScriptPosition.BodyInside)
<script>
    $(document).ready(function () {
        for (var i = 0; i < $('.form-control').length; i++) {
            $('.form-control').eq(i).attr('placeholder', ' ');
        }
        SetHeightTextarea(['AddressUser', 'Content']);
    });
</script>
