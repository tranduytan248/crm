@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_CategoryModel
@Html.HiddenFor(model => model.Group_Category_ID)
@Html.HiddenFor(model => model.Cate_CategoryID)
@Html.AntiForgeryToken()
<div class="form-group row">
    @Html.TitleFor(model => model.CodeCategory, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-9">
        @if (Model.Cate_CategoryID > 0)
        {
            @Html.TextBoxFor(model => model.CodeCategory, new { @readonly = "true", @class = "form-control col-md-6", placeholder = AppProcessor.Messagor.GetMessage("Category_Code") })
        }
        else
        {
            @Html.TextBoxFor(model => model.CodeCategory, new { @class = "form-control col-md-6", placeholder = AppProcessor.Messagor.GetMessage("Category_Code") })
        }
        @Html.ValidationMessageFor(model => model.CodeCategory, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.NameCategory, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-9">
        @Html.TextBoxFor(model => model.NameCategory, new { @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("Category_Name") })
        @Html.ValidationMessageFor(model => model.NameCategory, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.OrderID, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-9">
        @Html.TextBoxFor(model => model.OrderID, new { @class = "form-control col-md-2", type = "number", placeholder = AppProcessor.Messagor.GetMessage("Category_Priority") })
        @Html.ValidationMessageFor(model => model.OrderID, "", new { @class = "text-danger" })
    </div>
</div>