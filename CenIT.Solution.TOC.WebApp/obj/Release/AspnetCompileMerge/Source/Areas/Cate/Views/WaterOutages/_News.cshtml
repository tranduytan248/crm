@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_WaterOutagesModel

@Html.AntiForgeryToken()
<div id="Language">
    @Html.HiddenFor(model => model.WaterOutagesId)

    <div class="row">

        <div class="col-12 col-md-9">
            <div class="form-group row">
                @Html.TitleFor(model => model.Title, new { @class = "col-sm-2 col-form-label text-sm-left pr-0 font-bold" })
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.Title, new { @class = "form-control col-md-10", placeholder = AppProcessor.Messagor.GetMessage("WaterOutages_Label_Title") })
                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                </div>
            </div>


            <div class="form-group row">
                @Html.TitleFor(model => model.Summary, new { @class = "col-sm-2 col-form-label text-sm-left pr-0 font-bold" })
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.Summary, new { rows = 3, @class = "form-control col-md-10", placeholder = AppProcessor.Messagor.GetMessage("WaterOutages_Label_Summary") })
                    @Html.ValidationMessageFor(model => model.Summary, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group row">
                @Html.TitleFor(model => model.WaterOutagesCategoriesId, new { @class = "col-sm-2 col-form-label text-sm-left pr-0 font-bold" })
                <div class="col-md-10">
                    @Html.DropDownListFor(model => model.WaterOutagesCategoriesId, new SelectList(Model.listWaterOutagesCategories, "Value", "Text"), "", new { @class = "form-control col-md-10" })
                    @Html.ValidationMessageFor(model => model.WaterOutagesCategoriesId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="ace-file-input ace-file-multiple">
                <div class="ace-file-container d-flex flex-column border-1 border-dashed brc-primary-m4 brc-h-warning-m1">
                    <div class="ace-file-placeholder h-100">
                        @Html.ImageForWaterOutages(model => model.ImageUrlFileBase, Model.ImageUrlPath, AppProcessor.Messagor.GetMessage("Employee_Avatar"), ".jpeg,.png,.gif,.jpg", new { @class = "col-sm-12 col-md-12 mx-auto my-1" })
                        @Html.HiddenFor(model => model.ImageUrl)
                    </div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.ImageUrl, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.Content, new { @class = "col-sm-2 col-form-label text-sm-left pr-0 font-bold" })
    </div>
    <div class="col-md-12">
        @Html.TextAreaFor(model => model.Content, new { @class = "w-100" })
        @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })
    </div>
</div>
    <script type="text/javascript">

        $(document).ready(function () {
            reloadCKEditor();
        });
    </script>

    @Html.RenderScripts(ScriptPosition.BodyInside)
