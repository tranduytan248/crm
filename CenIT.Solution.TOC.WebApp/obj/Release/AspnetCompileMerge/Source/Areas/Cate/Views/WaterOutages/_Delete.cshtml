@using TSFramework.Libs.Processors
@model Core.Cate.Models.KWC_WaterOutagesModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("WaterOutages_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "WaterOutages", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "WaterOutages_OnProcessSuccess(data, 'DeleteWaterOutages')"
    }, new { @class = "form-horizontal", id = "DeleteWaterOutages" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.OutageId)
        @Html.HiddenFor(model => model.Area)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}