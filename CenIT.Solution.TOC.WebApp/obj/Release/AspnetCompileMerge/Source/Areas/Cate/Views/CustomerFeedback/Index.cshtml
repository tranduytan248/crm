@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("CustomerFeedback_Title");
}

@section PageTitle
{
    @ViewBag.Title
}
<link rel="stylesheet" type="text/css" href="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/tiny-date-picker.css">
<style>
    .w1pc {
        width: 1% !important;
    }

    .d-trangthai .select2-selection__clear {
        display: none !important;
    }
</style>
@Html.Partial("_Search")
<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md p-2">
            <table id="DSCustomerFeedback" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="w1pc">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>Ngày gửi</th>
                        <th>Khách hàng</th>
                        <th>Thông tin @AppProcessor.Messagor.GetMessage("CustomerFeedback_Title")</th>
                        <th>Trạng thái</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section BottomScript
{
    <script src="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/dist/date-range-picker.js"></script>
    <script src="@Url.Content("~/Areas/Cate/Views/CustomerFeedback/CustomerFeedback.js")?t=@DateTime.Now.ToString("ddMMyyyyHHmmss")"></script>
}