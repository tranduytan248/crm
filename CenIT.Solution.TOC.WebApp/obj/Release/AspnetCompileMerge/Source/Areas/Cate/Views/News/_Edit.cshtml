@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("News_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{

    @using (Html.BeginForm("Edit", "News", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "EditNews", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_News")
        </div>
    }

    <script type="text/javascript">
    $(document).ready(function () {

            $('.modal-footer #btnSave').attr('type', 'button');

            // Nhấn gửi
            $("#btnSave").click(function () {
                for (instance in CKEDITOR.instances) {
                    CKEDITOR.instances[instance].updateElement();
                }
                $("form#EditNews").submit();
            });

            $('form#EditNews').ajaxForm({
                success: function (response) {
                    if (response.status != undefined) {
                        if ($("#ModalContent #modal_EditNews #chkNotDismissModal").is(":checked")) {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tableNews.ajax.reload(null, false);
                                response.status = undefined;
                                $("#ModalContent #modal_EditNews form")[0].reset();
                            }
                        } else {
                            if (!response.status && response.errorCode == 1) {
                                eval(response.message);
                                response.status = undefined;
                            } else {
                                $("#ModalContent #modal_EditNews").modal("hide");
                                $("#ModalContent #modal_EditNews").on('hidden.bs.modal',
                                    function () {
                                        if (response.status != undefined) {
                                            eval(response.message);
                                            _tableNews.ajax.reload(null, true);
                                            response.status = undefined;
                                        }
                                    });
                            }
                        }
                    } else {
                        $("#ModalContent #modal_EditNews" + " #bodyForm").html(response);
                    }
                }
            });
    })
    </script>

    @*@using (Ajax.BeginForm("Edit", "News", new { area = "Cate" }, new AjaxOptions
        {
            HttpMethod = "POST",
            OnSuccess = "News_OnProcessSuccess(data, 'EditNews')"
        }, new { @class = "form-horizontal", id = "EditNews" }))
        {
            <div id="bodyForm">
                @Html.Partial("_News")
            </div>
        }*@
}

