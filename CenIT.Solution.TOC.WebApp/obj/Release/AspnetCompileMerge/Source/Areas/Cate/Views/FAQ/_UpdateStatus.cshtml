@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_FAQModel
@{
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}
@section FormType{
    @ViewBag.Color
}
@section FormBody{
    @using (Ajax.BeginForm("UpdateStatus", "FAQ", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "FAQ_OnProcessSuccess(data, 'UpdateStatus')"
    }, new { @class = "form-horizontal", id = "UpdateStatus" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.Question)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}