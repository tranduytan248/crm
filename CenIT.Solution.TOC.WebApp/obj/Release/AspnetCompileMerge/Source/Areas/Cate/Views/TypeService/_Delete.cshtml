@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_TypeServiceModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("TypeService_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "TypeService", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "TypeService_OnProcessSuccess(data, 'DeleteTypeService')"
    }, new { @class = "form-horizontal", id = "DeleteTypeService" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.TypeServiceId)
        @Html.HiddenFor(model => model.TypeServiceName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}