@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_BannerModel

@{
    ViewBag.Title = "Cập nhật trạng thái banner";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    warning
}

@section FormBody{
    @using (Ajax.BeginForm("UpdateStatus", "Banners", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Banners_OnProcessSuccess(data, 'UpdateStatusBanners')"
    }, new { @class = "form-horizontal", id = "DeleteNews" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.BannerId)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}