@model Core.Cate.Models.Cate_ReqCreateQRCodeModel
@using TSFramework.Libs.Processors

@{
    Layout = "~/Views/Shared/_Login.cshtml";
}
@section HeadCss{
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
}
    <style>
        body {
            background: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        #qrCodeContainer, #notifySuccess {
            background: #fff;
            /*        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);*/
            padding: 40px 60px;
            text-align: center;
            max-width: 480px;
            width: 100%;
            animation: fadeIn 0.8s ease-in-out;
        }

        #qrCode {
            position: relative;
            width: 250px;
            height: 250px;
            margin: 0 auto 20px;
        }

            #qrCode img {
                width: 250px;
                height: 250px;
                border: 8px solid #e5e7eb;
                border-radius: 16px;
                margin-bottom: 20px;
            }

        /* Skeleton QR giả lập khi chưa load */
        .qr-skeleton {
            width: 100%;
            height: 100%;
            border: 8px solid #e5e7eb;
            border-radius: 16px;
            background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%);
            background-size: 200% 100%;
            animation: qr-loading 1.5s infinite;
        }

        @@keyframes qr-loading {
            from {
                background-position: 200% 0;
            }

            to {
                background-position: -200% 0;
            }
        }

        #qrCodeContainer h2 {
            margin: 8px 0;
            font-size: 1.1rem;
            /*color: #374151;*/
        }

            #qrCodeContainer h2:first-of-type {
                font-size: 1.4rem;
                font-weight: bold;
                color: #1f2937;
                margin-bottom: 15px;
            }

            #qrCodeContainer h2:nth-of-type(2) {
                font-size: 1rem;
                font-weight: normal;
                color: #6b7280;
                margin-bottom: 25px;
            }

        .amount {
            font-size: 1.5rem !important;
            font-weight: bold;
            color: #dc3545;
            margin-top: 10px;
        }

        .infor-inv {
            font-weight: bold;
            font-size: 1.3rem;
        }

        .infor-inv-result {
            color: #2563eb;
        }

        /* Giao diện thanh toán thành công */
        #notifySuccess, #notifyPayment {
            display: none;
            background: #fff;
            /*        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);*/
            padding: 50px 40px;
            text-align: center;
            max-width: 480px;
            width: 100%;
            animation: fadeIn 0.8s ease-in-out;
        }

            #notifySuccess.active, #notifyPayment.active {
                display: block;
                animation: scaleUp 0.5s ease-in-out forwards;
            }

        /*Giao diện thất bại*/
        #notifyError {
            display: none;
            background: #fff;
            /*        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);*/
            padding: 50px 40px;
            text-align: center;
            max-width: 480px;
            width: 100%;
            animation: fadeIn 0.8s ease-in-out;
        }

            #notifyError.active {
                display: block;
                animation: scaleUp 0.5s ease-in-out forwards;
            }
        /* Hiệu ứng fade + scale */
        @@keyframes scaleUp {
            0% {
                transform: scale(0.8);
                opacity: 0;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* Biểu tượng dấu tích */
        .success-icon {
            position: relative;
            width: 100px;
            height: 100px;
            margin: 0 auto 25px;
            border-radius: 50%;
            background-color: #16a34a1a;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: pop 0.6s ease-in-out;
        }

        .error-icon {
            position: relative;
            width: 100px;
            height: 100px;
            margin: 0 auto 25px;
            border-radius: 50%;
            background-color: #ef5350;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: pop 0.6s ease-in-out;
        }

        @@keyframes pop {
            0% {
                transform: scale(0.6);
                opacity: 0;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* Dấu checkmark */
        .success-icon .checkmark {
            width: 50px;
            height: 25px;
            border-left: 6px solid #16a34a;
            border-bottom: 6px solid #16a34a;
            transform: rotate(-45deg);
            animation: drawCheck 0.8s ease forwards;
        }

        .error-icon .times {
            position: relative;
            width: 50px;
            height: 50px;
        }

            .error-icon .times::before,
            .error-icon .times::after {
                content: "";
                position: absolute;
                width: 6px;
                height: 50px;
                background-color: #fff; /* hoặc #ef5350 nếu muốn */
                top: 0;
                left: 50%;
                transform-origin: center;
            }

            .error-icon .times::before {
                transform: translateX(-50%) rotate(45deg);
            }

            .error-icon .times::after {
                transform: translateX(-50%) rotate(-45deg);
            }

        @@keyframes drawCheck {
            0% {
                opacity: 0;
                transform: rotate(-45deg) scale(0.5);
            }

            100% {
                opacity: 1;
                transform: rotate(-45deg) scale(1);
            }
        }

        /* Tiêu đề và mã giao dịch */
        #notifySuccess h1, #notifyPayment h1 {
            color: #16a34a;
            font-size: 1.8rem;
            margin-bottom: 10px;
            font-weight: bold;
        }

        #notifyError h1 {
            color: #ef5350;
            font-size: 1.8rem;
            margin-bottom: 10px;
            font-weight: bold;
        }

        #notifySuccess p, #notifyError p {
            color: #374151;
            font-size: 1rem;
            margin: 15px 0 30px 0;
        }


        .button-group {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-top: 30px;
        }

        .btn {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 1rem;
            font-weight: 500;
            padding: 10px 24px;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
        }

            /* Nút chính (Tải về) */
            .btn.primary {
                background: linear-gradient(135deg, #2563eb, #1d4ed8);
                color: white;
            }

                .btn.primary:hover {
                    background: linear-gradient(135deg, #1d4ed8, #1e40af);
                    transform: translateY(-2px);
                    box-shadow: 0 6px 14px rgba(37, 99, 235, 0.3);
                }

            /* Nút phụ (Trở về) */
            .btn.secondary {
                background: #f3f4f6;
                color: #374151;
                border: 1px solid #d1d5db;
            }

                .btn.secondary:hover {
                    background: #e5e7eb;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 14px rgba(156, 163, 175, 0.3);
                }
    </style>

    <div id="qrCodeContainer">
        <h4 style="font-size: 0.8rem;">Mở ứng dụng VNPT Money/ ngân hàng quét mã QR bên dưới để thanh toán</h4>
        <div id="qrCode">
            <div class="qr-skeleton"></div>
        </div>

        <h2>@AppProcessor.Messagor.GetMessage("ACCOUNT_NO")</h2>
        <h2>@AppProcessor.Messagor.GetMessage("ACCOUNT_NAME")</h2>

        <h2 class="infor-inv">Mã hóa đơn: <span class="infor-inv-result">@Model.InvNo</span></h2>
        <h2 class="infor-inv">Mã hợp đồng: <span class="infor-inv-result">@Model.ContractCode</span></h2>
        <h2 class="infor-inv">
            Tháng thanh toán: <span class="infor-inv-result">@Model.Period.ToString("MM-yyyy")</span>
        </h2>
        <h2 class="amount">Số tiền: @String.Format("{0:N0} VNĐ", Model.TotalAmount)</h2>
        <hr />
        <div class="button-group">
            <button class="btn primary"><i class="fa fa-download"></i> Tải về</button>
            <button class="btn secondary"><i class="fa fa-arrow-left"></i> Quay lại</button>

        </div>

    </div>

    <div id="notifySuccess">
        <div class="success-icon">
            <div class="checkmark"></div>
        </div>
        <h1>Thanh toán thành công!</h1>
        <p id="maGiaoDich"></p>
        <div class="button-group">
            <button class="btn secondary" onclick="window.location.href='/invoice/rollback'">
                <i class="fa fa-arrow-left"></i> Quay lại
            </button>
        </div>
    </div>

    <div id="notifyError">
        <div class="error-icon">
            <div class="times"></div>
        </div>
        <h1>Đã có lỗi xảy ra !</h1>
        <p id="messageError"></p>
        <div class="button-group">
            <button class="btn secondary" onclick="window.location.href='/invoice/rollback'">
                <i class="fa fa-arrow-left"></i> Quay lại
            </button>
        </div>
    </div>

    <div id="notifyPayment">
        <div class="success-icon">
            <div class="checkmark"></div>
        </div>
        <h1>Hóa đơn này đã được thanh toán !</h1>
        <div class="button-group">
            <button class="btn secondary" onclick="window.location.href='/invoice/rollback'">
                <i class="fa fa-arrow-left"></i> Quay lại
            </button>
        </div>
    </div>
    <script src="~/Contents/Base/plugins/signalR/jquery.signalR-2.4.3.js"></script>
    <script src="~/signalr/hubs"></script>
    <script>
    var hubPaymeny = null;
    var InvNo = null;
    var ContractCode = null;
    var Period = null;
    var TotalAmount = null;
    var Checksum = null;
    var currentBill = null;
    var userPay = null;

    $(document).ready(function ()
    {
        initSignalR();
        GenQRCode();
    });

    function GenQRCode() {
        $.ajax({
            url: "/api/VNPTPayQR/GenQrCode",
            type: "POST",
            data: {
                InvNo: @Html.Raw(Json.Encode(Model.InvNo)),
                ContractCode: @Html.Raw(Json.Encode(Model.ContractCode)),
                Period: @Html.Raw(Json.Encode(Model.Period.ToString("yyyy-MM-dd"))),
                TotalAmount: @Html.Raw(Json.Encode(Model.TotalAmount)),
                UserPay: @Html.Raw(Json.Encode(Model.UserPay)),
                Checksum: @Html.Raw(Json.Encode(Model.Checksum))
            },
            success: function (result) {
                if (result.status && result.data && result.data.qrcodeImage) {
                    $("#qrCode").html(`<img src="data:image/jpeg;base64,${result.data.qrcodeImage}" alt="QR Code" />`);
                }
                else if (!result.status && result.isPayed) {
                    $("#qrCodeContainer").hide();
                    $("#notifyPayment").addClass("active");
                }
                else  {
                   //eval(showNotify('Lỗi', 'fa fa-exclamation-circle', 'Có lỗi xảy ra khi tạo mã QR Code', '', '', 'danger', 'bl'))
                    // eval(result.message);
                    $("#qrCodeContainer").hide();
                    $("#notifyError").addClass("active");
                    $("#messageError").html(`<strong>Lỗi:</strong> ${result.message}`);
                }
            },
            error: function (xhr, status, error) {
                console.error("Lỗi AJAX:", error);
                console.log("Chi tiết:", xhr.responseText);
            }
        });
    }
    function initSignalR() {
        console.log("Init Signal");
        if (hubPaymeny == null) {
            debugger;
                hubPaymeny = $.connection.notifyPOHub;

            hubPaymeny.client.paymentSuccess = async function (billNumber) {
                    console.log("Thanh toán thành công cho hóa đơn:", new Date() +  billNumber);
                    var currentBill = @Html.Raw(Json.Encode(Model.ContractCode)) + @Html.Raw(Json.Encode(Model.Period.ToString("yyyyMM"))) + "CSKH";
                    console.log(billNumber, currentBill)
                    if (billNumber == currentBill) {
                        $("#qrCodeContainer").hide();
                        $("#notifySuccess").addClass("active");
                        $("#maGiaoDich").html(`<strong>Mã giao dịch:</strong> ${billNumber}`);
                    }
                };

                $.connection.hub.start().done(function () {
                    console.log(" Connected to SignalR hub.");
                }).fail(function (err) {
                    console.error(" Lỗi kết nối Hub:", err);
                });
            }

            // Khi đóng tab hoặc rời trang
            $(window).on("unload", function () {
                if ($.connection.hub && $.connection.hub.state === $.signalR.connectionState.connected) {
                    $.connection.hub.stop();
                    console.log("🔌 Disconnected from SignalR hub.");
                }
            });
    }


     // Xử lý nút Tải về
    $(document).on("click", ".btn.primary", function () {
        const qrImg = $("#qrCode img").attr("src");
        if (!qrImg) {
            eval(showNotify('Lỗi', 'fa fa-exclamation-circle', 'Mã QR chưa được tạo thành công', '', '', 'danger', 'bl'))
            ///alert("QR chưa được tải, vui lòng đợi...");
            return;
        }

        // Tạo tên file theo mã hợp đồng + kỳ
        const fileName = `QR_${@Html.Raw(Json.Encode(Model.ContractCode))}_${@Html.Raw(Json.Encode(Model.Period.ToString("yyyyMM")))}.jpg`;

        // Tạo thẻ <a> ảo để tải file
        const link = document.createElement("a");
        link.href = qrImg;
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });

    // Xử lý nút Trở về
    $(document).on("click", ".btn.secondary", function () {
        window.location.href = "/invoice/rollback";
    });
    </script>

