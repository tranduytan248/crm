@model Modules.Cate.Areas.Cate.Data.ResultPageModel
@{
    Layout = "~/Views/Shared/_Login.cshtml";
    string icon = Model.IsSuccess ? "fa fa-check text-success" : "fas fa-exclamation-triangle text-warning";
    string color = Model.IsSuccess ? "success" : "danger";
    ViewBag.Title = "Thông báo";
    string info = Model.IsSuccess ? "Yêu cầu của Quý khách hàng đã được ghi nhận thành công. Mọi chi tiết vui lòng liên hệ tổng đài CSKH 02583828807."
        : "Mọi chi tiết vui lòng liên hệ tổng đài CSKH 02583828807.";
}

@section HeadCss{
    <link href='http://fonts.googleapis.com/css?family=Roboto' rel='stylesheet' type='text/css'>
    <link href="~/Areas/Cate/Views/EForm/EForm.css?v=@DateTime.Now.ToString("HHmmss")" rel="stylesheet" />
}

<div class="h-100 d-flex align-items-center">
    <div class="text-center px-3">
        <i class="@icon" style="font-size: 20vw; padding-bottom: 10px;"></i>
        <div class="text-@color text-140 text-600">
            @Model.Message
        </div>
        <div class="text-blue text-600 text-95 pt-2">@Model.SubMessage</div>
        <div>@info</div>
    </div>
</div>