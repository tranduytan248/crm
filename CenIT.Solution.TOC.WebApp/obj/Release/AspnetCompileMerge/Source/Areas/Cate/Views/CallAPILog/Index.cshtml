@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("CallAPILog_Title");
}
@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
}

<style>
    #DSCallAPILog td {
        max-width: 600px;
        white-space: pre-wrap !important;
        word-break: break-word !important;
    }

</style>

<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSCallAPILog" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("APINameOrURL")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Request")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Response")</th>
                        <th>@AppProcessor.Messagor.GetMessage("CreateDate")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Cate/Views/CallAPILog/CallAPILog.js")"></script>
}
