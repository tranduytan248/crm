@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_TypeServiceModel

@Html.AntiForgeryToken()
<div id="Language">
    @Html.HiddenFor(model => model.TypeServiceId)

    <div class="form-group row">
        @Html.TitleFor(model => model.TypeServiceName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            @Html.TextBoxFor(model => model.TypeServiceName, new { @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("TypeService_Label_Name") })
            @Html.ValidationMessageFor(model => model.TypeServiceName, "", new { @class = "text-danger" })
        </div>
    </div>

</div>
