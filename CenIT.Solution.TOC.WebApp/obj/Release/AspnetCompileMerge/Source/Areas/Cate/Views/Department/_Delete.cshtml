@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_DepartmentModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Department_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Department", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Department_OnProcessSuccess(data, 'DeleteDepartment')"
    }, new { @class = "form-horizontal", id = "DeleteDepartment" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.DepartmentId)
        @Html.HiddenFor(model => model.DepartmentName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}