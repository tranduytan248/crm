@using TSFramework.Libs.Processors
@model Core.Cate.Models.KWC_WaterOutagesModel

@Html.AntiForgeryToken()

<div id="WaterOutages">
    @Html.HiddenFor(model => model.OutageId)

    <div class="row">

        <div class="col-md-12">
            <div class="form-group row">
                @Html.TitleFor(model => model.Area, new { @class = "col-sm-2 col-form-label text-sm-left pr-0 font-bold" })
                <div class="col-md-7">
                    @Html.TextBoxFor(model => model.Area, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("WaterOutages_Label_Area") })
                    @Html.ValidationMessageFor(model => model.Area, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group row">
                @Html.TitleFor(model => model.StartTime, new { @class = "col-sm-2 col-form-label text-sm-left pr-0 font-bold" })

                <div class="col-sm-4">
                    @Html.TextBoxFor(model => model.StartTime, "{0:dd/MM/yyyy HH:mm:ss}", new
                    {
                        @class = "datetimepicker form-control",
                        placeholder = "Chọn ngày giờ"
                    })
                    @Html.ValidationMessageFor(model => model.StartTime, "", new { @class = "text-danger" })

                </div>

                @Html.TitleFor(model => model.EndTime, new { @class = "col-sm-2 col-form-label text-sm-left pr-0 font-bold" })

                <div class="col-sm-4">
                    @Html.TextBoxFor(model => model.EndTime, "{0:dd/MM/yyyy HH:mm:ss}", new
                    {
                        @class = "datetimepicker form-control",
                        placeholder = "Chọn ngày giờ"
                    })
                    @Html.ValidationMessageFor(model => model.EndTime, "", new { @class = "text-danger" })

                </div>
            </div>

        </div>
        
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.Reason, new { @class = "col-sm-2 col-form-label text-sm-left pr-0 font-bold" })
    </div>
    <div class="col-md-12">
        @Html.TextAreaFor(model => model.Reason, new { @class = "w-100" })
        @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
    </div>
</div>
    <script type="text/javascript">

        $(document).ready(function () {
            reloadCKEditor();
        });   
    </script>

