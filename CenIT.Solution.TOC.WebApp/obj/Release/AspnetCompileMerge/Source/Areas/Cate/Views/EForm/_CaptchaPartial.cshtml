@using CaptchaMvc.HtmlHelpers
@Html.Captcha("Làm mới", "", 6)
<div id="captcha_err" class="field-validation-error text-danger"></div>
<script>
    $(document).ready(function () {
        $("#CaptchaInputText").addClass("mt-2 form-control shadow-none radius-5").attr('placeholder', 'Nhập mã captcha');
        $("#renderCaptcha br").addClass("d-none");
        $('#renderCaptcha a').removeAttr('href');
        $('#renderCaptcha a').addClass('m-2 text-template').removeAttr('href')
            .attr('title', 'Làm mới Captcha')
            .html('<i class="fas fa-sync"></i> Làm mới');

        $('#captcha_err').html($('span[data-valmsg-for=CaptchaInputText]').text());
    });
</script>