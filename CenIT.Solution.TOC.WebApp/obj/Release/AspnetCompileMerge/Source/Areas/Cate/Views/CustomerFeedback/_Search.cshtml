@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_CustomerFeedbackSearchModel


<div class="card dcard" id="SearchCustomerFeedback">
    <div class="card-header">
        <h5 class="card-title text-blue text-500">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Condition_Title")
        </h5>
        <div class="card-toolbar">
            <a href="#" data-action="toggle" class="card-toolbar-btn text-blue">
                <i class="fa fa-chevron-up"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3">
            <div class="form-group row">
                <div class="col-md-4">
                    <label class="col-form-label text-sm-right pr-0 font-bold">Thời gian gửi</label>
                    <div id="receivedOn-wrapper">
                        <div class="form-row">
                            <div class="col">
                                @Html.TextBoxFor(model => model.TuNgay, "dd/MM/yyyy", new
                                {
                                    @class = "form-control ex-inputs-start",
                                    @autocomplete = "off",
                                    placeholder = "DD/MM/YYYY"
                                })
                            </div>
                            <div class="text-grey-l2"> _ </div>
                            <div class="col">
                                @Html.TextBoxFor(model => model.DenNgay, "dd/MM/yyyy", new
                                {
                                    @class = "form-control ex-inputs-end",
                                    @autocomplete = "off",
                                    placeholder = "DD/MM/YYYY"
                                })
                            </div>
                        </div>
                        <div id="receivedOn-container" class="dp-daterange-picker"></div>
                    </div>
                </div>
                <div class="col-md-2 d-trangthai">
                    <label class="col-form-label text-md-right pr-0 font-bold">Trạng thái</label>
                    @Html.DropDownListFor(model => model.Status, new SelectList(new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Tất cả", Value = "-1" },
                        new SelectListItem { Text = "Mới", Value = "0" },
                        new SelectListItem { Text = "Đã phản hồi", Value = "1" },
                    }, "Value", "Text"), new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    <label class="col-form-label text-md-right pr-0 font-bold">Từ khóa</label>
                    @Html.TextBoxFor(model => model.TuKhoa, new { @class = "form-control t_tip", placeholder = "Tìm kiếm theo mã góp ý, tên chủ đề, tiêu đề góp ý, thông tin khách hàng", @title="", @data_original_title= "Tìm kiếm theo mã góp ý, tên chủ đề, tiêu đề góp ý, thông tin khách hàng", @data_rel="tooltip" })
                </div>
                <div class="col-md-3">
                    <label class="col-form-label text-md-right pr-0 font-bold">Chủ đề</label>
                    @Html.DropDownListFor(model => model.CategoryFeedbackID, new SelectList(Model.lstCategoryFeedback, "Value", "Text"), "",new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="col-md-12 text-center">
            <button type="button" class="btn btn-primary" onclick="_search()"><i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Condition_Title")</button>
            <button type="button" class="btn btn-success" onclick="ExportDanhSachKhachHang()"><i class="fa fa-download"></i>&nbsp;Xuất excel</button>

        </div>
    </div>
</div>
<script type="text/javascript">
    function _initDateRangePicker(eleContainer, eleWrapper, eleFromDate, eleToDate) {
        // Give Result Contract Date
        var daterange_container = document.querySelector(eleContainer)
        // Inject DateRangePicker into our container
        var daterangePicker = DateRangePicker.DateRangePicker(daterange_container, {
            mode: 'dp-permanent',
            startOpts: {
                lang: {
                    days: ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'],
                    months: [
                        'Tháng 1',
                        'Tháng 2',
                        'Tháng 3',
                        'Tháng 4',
                        'Tháng 5',
                        'Tháng 6',
                        'Tháng 7',
                        'Tháng 8',
                        'Tháng 9',
                        'Tháng 10',
                        'Tháng 11',
                        'Tháng 12',
                    ],
                    today: 'Hôm nay',
                    clear: 'Xoá',
                    close: 'Đóng',
                }
            },
            endOpts: {
                lang: {
                    days: ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'],
                    months: [
                        'Tháng 1',
                        'Tháng 2',
                        'Tháng 3',
                        'Tháng 4',
                        'Tháng 5',
                        'Tháng 6',
                        'Tháng 7',
                        'Tháng 8',
                        'Tháng 9',
                        'Tháng 10',
                        'Tháng 11',
                        'Tháng 12',
                    ],
                    today: 'Hôm nay',
                    clear: 'Xoá',
                    close: 'Đóng',
                },
            }
        }).on('statechange', function (_, rp) {
            // Update the inputs when the state changes
            var range = rp.state
            $(eleFromDate).val(range.start ? moment(range.start).format("DD/MM/YYYY") : '')
            $(eleToDate).val(range.end ? moment(range.end).format("DD/MM/YYYY") : '')
        })

        $(eleFromDate).on('focus', function () {
            daterange_container.classList.add('visible')
        });

        $(eleToDate).on('focus', function () {
            daterange_container.classList.add('visible')
        })

        var daterange_wrapper = document.querySelector(eleWrapper)
        var previousTimeout = null;
        $(daterange_wrapper).on('focusout', function () {
            if (previousTimeout) clearTimeout(previousTimeout)
            previousTimeout = setTimeout(function () {
                if (!daterange_wrapper.contains(document.activeElement)) {
                    daterange_container.classList.remove('visible')
                }
            }, 10)
        })
    }

    $(function () {
        _initDateRangePicker('#receivedOn-container', '#receivedOn-wrapper', '#TuNgay', '#DenNgay');
        //_initDateRangePicker('#giveResultOn-container', '#giveResultOn-wrapper', '#GiveResultFromDate', '#GiveResultToDate');

        $('.selectpicker').on('loaded.bs.select', function (e, clickedIndex, isSelected, previousValue) {
            $(this).next('button').tooltip({ trigger: 'hover' });
        });
    });
</script>
