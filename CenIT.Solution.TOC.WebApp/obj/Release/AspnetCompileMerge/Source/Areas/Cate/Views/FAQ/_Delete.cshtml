@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_FAQModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("FAQ_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "FAQ", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "FAQ_OnProcessSuccess(data, 'DeleteFAQ')"
    }, new { @class = "form-horizontal", id = "DeleteFAQ" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.Question)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}