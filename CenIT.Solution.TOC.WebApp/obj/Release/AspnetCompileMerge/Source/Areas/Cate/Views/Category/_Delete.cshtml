@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_CategoryModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Category_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Category", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Category_OnProcessSuccess(data, 'DeleteCategory')"
    }, new { @class = "form-horizontal", id = "DeleteCategory" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Cate_CategoryID)
        @Html.HiddenFor(model => model.CodeCategory)
        @Html.HiddenFor(model => model.NameCategory)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}