@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_ServiceRequestCustomerModel
@using System.Configuration
@{
    string[] arrClassColor = { "warning", "primary", "info", "success", "danger" };
    string ImgKhachHangPath = "/Contents/Base/imgs/app.ico";
    string avatarDefault = ConfigurationManager.AppSettings["AppTouristAvatarDefault_URL"];
    string ImgRootPath = ConfigurationManager.AppSettings["AppImageRoot_Path"] ?? "/Contents/imgs";

    string AnhDuKhach_FullPath = ImgKhachHangPath;

    string[] DSAnh;
}

<div class="card mb-3">
    <div class="card-header bg-transparent brc-default-l3">
        <h5 class="card-title text-dark-m2 pl-1 text-130 text-primary">
            <i class="fas fa-info-circle"></i> Thông tin yêu cầu
        </h5>
    </div>
    <div class="card-body p-3">
        <div class="d-flex flex-column flex-md-row">
            <div>
                <div class="d-flex align-items-start">
                    <img src="@AnhDuKhach_FullPath" class="w-5 h-5 mx-1 radius-round p-2px bgc-white border-1 brc-grey-l1 shadow-sm">
                    <div class="ml-2">
                        <a href="#" class="text-600">
                            @Model.RequesterName
                        </a>
                        <div class="text-grey text-sm">
                            <i class="fas fa-envelope w-3 text-center"></i>@Model.Email
                        </div>
                        <div class="text-grey text-sm">
                            <i class="fas fa-phone w-3 text-center"></i>@Model.Phone
                        </div>
                    </div>
                </div>
            </div>

            <div class="ml-auto text-right mt-2 mt-md-0">
                <span class="badge btn-@arrClassColor[Model.Position-1] badge-lg arrowed ml-n1 mb-1">
                    @Model.StatusProcessName
                </span>
            </div>
        </div>

        <div class="mt-2">
            <div class="alert bgc-secondary-l4 text-dark-m1 border-none border-l-4 brc-blue radius-0 py-1 mb-0">
                <div>
                    <i class=" fas fa-feather-alt text-blue-d1 align-middle w-3 text-center"></i>
                    Yêu cầu về:
                    @Model.TypeServiceName
                </div>
                <div>
                    <i class="far fa-clock text-blue-d1 align-middle w-3 text-center"></i>
                    Ngày yêu cầu:
                    @Model.RequestDate.ToString("dd/MM/yyyy HH:mm:ss")
                </div>
            </div>
        </div>


        <div class="mt-2">
            <div class="alert alert-secondary bgc-secondary-l4 brc-secondary-l2 text-dark-tp2" role="alert">
                <h5 class="alert-heading text-primary-d1 font-bolder">
                    Thông tin yêu cầu chi tiết
                </h5>
                <a href="/Cate/ServiceRequests/renderHTMLForm/@Model.RequestId" id="PreviewForm" data-modal="true" data-modal-id="PreviewForm">Click vào đây để xem chi tiết yêu cầu</a>

                @*<a data-width="fullscreen" id="CateServiceRequestsUpdateStatusProcess1" {8}="" data-modal="" data-modal-id="UpdateStatusProcess" class="btn btn-lighter-primary mr-1" data-rel="tooltip" title="" href="/Cate/ServiceRequests/UpdateStatusProcess/1" data-original-title="Cập nhật"><i class="far fa-edit text-primary text-120"></i></a>
                    </div>*@
            </div>
        </div><!-- /.card-body -->
    </div>
</div>
