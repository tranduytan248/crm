@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_GroupCategoryModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("GroupCategory_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "GroupCategory", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "GroupCategory_OnProcessSuccess(data, 'DeleteGroupCategory')"
    }, new { @class = "form-horizontal", id = "DeleteGroupCategory" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Group_Category_ID)
        @Html.HiddenFor(model => model.Group_Category_Code)
        @Html.HiddenFor(model => model.Group_Category_Name)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}