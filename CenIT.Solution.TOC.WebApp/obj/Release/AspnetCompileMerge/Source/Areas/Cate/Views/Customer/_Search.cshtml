@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_CustomerSearchModel
<style>
    #SearchCustomer .datepicker.datepicker-dropdown.dropdown-menu {
        z-index: 998 !important;
    }

    #SearchCustomer .dp-daterange-picker.visible {
        z-index: 999 !important;
    }

    #SearchCustomer .select2-selection__clear,
    #CustomerInfo .select2-selection__clear {
        display: none !important;
    }
</style>
<div class="card dcard" id="SearchCustomer">
    <div class="card-body collapse show p-0">
        <div class="form-horizontal row px-3 pt-3">
            <div class="col-md-6">
                <div class="form-group row">
                    @Html.TitleFor(model => model.TuKhoa, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
                    <div class="col-md-9">
                        @Html.TextBoxFor(model => model.TuKhoa, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Customer_Placeholder_TuKhoa") })
                        @Html.ValidationMessageFor(model => model.TuKhoa, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group row">
                    @Html.TitleFor(model => model.TuNgay, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
                    <div class="col-md-8">
                        <div id="receivedOn-wrapper">
                            <div class="form-row">
                                <div class="col">
                                    @Html.TextBoxFor(model => model.TuNgay, "dd/MM/yyyy", new
                                    {
                                        @class = "form-control ex-inputs-start",
                                        @autocomplete = "off",
                                        placeholder = "DD/MM/YYYY"
                                    })
                                </div>
                                <div class="text-grey-l2"> _ </div>
                                <div class="col">
                                    @Html.TextBoxFor(model => model.DenNgay, "dd/MM/yyyy", new
                                    {
                                        @class = "form-control ex-inputs-end",
                                        @autocomplete = "off",
                                        placeholder = "DD/MM/YYYY"
                                    })
                                </div>
                            </div>
                            <div id="receivedOn-container" class="dp-daterange-picker"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="_tableCustomer.ajax.reload(null, false);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        _initDateRangePicker('#receivedOn-container', '#receivedOn-wrapper', '#TuNgay', '#DenNgay');
        $('.selectpicker').on('loaded.bs.select', function (e, clickedIndex, isSelected, previousValue) {
            $(this).next('button').tooltip({ trigger: 'hover' });
        });
    });
</script>
