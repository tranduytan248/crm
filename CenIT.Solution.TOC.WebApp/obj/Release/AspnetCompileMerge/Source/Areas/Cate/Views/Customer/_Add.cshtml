@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("Customer_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("Add", "Customer", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Customer_OnProcessSuccess(data, 'AddCustomer')",
    }, new { @class = "form-horizontal", id = "AddCustomer" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Customer")
        </div>
    }
<script>
    function fnSetValueToHidden() {
        var arr = [];
        for (var i = 0; i < $('input[name=UseForItem]:checked').length; i++) {
            arr.push($('input[name=UseForItem]:checked').eq(i).val())
        }
        $('#UseFor').val(arr.toString());
    }
</script>
}

@section ContinueForm{

}