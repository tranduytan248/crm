@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_NewsModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("News_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "News", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "News_OnProcessSuccess(data, 'DeleteNews')"
    }, new { @class = "form-horizontal", id = "DeleteNews" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.NewsId)
        @Html.HiddenFor(model => model.Title)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}