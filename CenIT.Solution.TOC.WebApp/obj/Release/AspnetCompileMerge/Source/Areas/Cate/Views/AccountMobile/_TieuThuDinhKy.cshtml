@using TSFramework.Libs.Processors
@model Core.Cate.Models.KWC_AccountMobileModel
@{
    ViewBag.Title = "Lượng nước tiêu thụ theo kỳ";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-tint"></i>
}

@section FormBody{

    <div class="row">
        <div class="col-md-6 pb-3">
            <div class="card dcard" id="card-5">
                <div class="card-header">
                    <div class="card-title text-blue text-600 text-120 py-1">
                        <i class="fas fa-chart-area text-blue mr-3px"></i> Biểu đồ lượng nước tiêu thụ trong 12 tháng gần nhất (Đvt: m<sup>3</sup>)
                    </div>
                </div><!-- /.card-header -->
                <div class="card-body p-0 collapse show">
                    <div id="chart"></div>
                </div><!-- /.card-body -->
            </div>
        </div>
        <div class="col-md-6">
            <div class="card ccard">
                <ul class="nav nav-tabs nav-tabs-simple nav-tabs-scroll border-b-1 brc-dark-l3 mx-0 mx-md-0 px-3 px-md-1 pt-2px" role="tablist">
                    @*<li class="nav-item mr-1">
                            <a class="nav-link p-3 brc-success-m1 bgc-h-success-l4 d-style p-3 bgc-h-success-l4 active" id="home16-tab-btn" data-toggle="tab" href="#home16" role="tab" aria-controls="home16" aria-selected="true">
                                <i class="fas fa-chart-area text-success mr-3px"></i>
                                <span class="d-n-active">
                                    Lượng nước tiêu thụ (m<sup>3</sup>)
                                </span>
                                <span class="d-active text-success-d1">
                                    Lượng nước tiêu thụ (m<sup>3</sup>)
                                </span>
                            </a>
                        </li>*@

                    <li class="nav-item mr-1">
                        <a class="nav-link p-3 brc-success-m1 d-style p-3 bgc-h-success-l4 radius-0 active" id="profile16-tab-btn" data-toggle="tab" href="#profile16" role="tab" aria-controls="profile16" aria-selected="false">
                            <i class="fas fa-table text-success mr-3px"></i>
                            <span class="d-n-active">
                                Chi tiết chỉ số tiêu thụ nước
                            </span>
                            <span class="d-active text-success-d1">
                                Chi tiết chỉ số tiêu thụ nước
                            </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link p-3 brc-danger-m1 bgc-h-danger-l4 d-style p-3 bgc-h-danger radius-0" id="more16-tab-btn" data-toggle="tab" href="#more16" role="tab" aria-controls="more16" aria-selected="false">
                            <i class="fas fa-file-signature text-danger mr-3px"></i>
                            <span class="d-n-active">
                                Lịch ghi chỉ số
                            </span>
                            <span class="d-active text-danger-d1">
                                Lịch ghi chỉ số
                            </span>
                        </a>
                    </li>
                </ul>

                <div class="card-body p-0">
                    <div class="tab-content tab-sliding border-0 p-0">
                        @*<div class="tab-pane show text-95 px-25 active" id="home16" role="tabpanel" aria-labelledby="home16-tab-btn">

                            </div>*@
                        <style>
                            #profile16 {
                                max-height: calc(80vh);
                                overflow-y: scroll !important;
                            }
                        </style>
                        <div class="tab-pane show text-95 p-3 active ace-scrollbar" id="profile16" role="tabpanel" aria-labelledby="profile16-tab-btn">

                        </div>

                        <div class="tab-pane text-95 p-3" id="more16" role="tabpanel" aria-labelledby="more16-tab-btn">
                            <table id="LichGhiChiSo" class="table table-hover table-bordered m-0" width="100%">
                                <thead class="text-center sticky-nav text-blue-m1 text-uppercase text-85 bgc-blue-l4">
                                    <tr>
                                        <th>STT</th>
                                        <th>Kỳ hóa đơn</th>
                                        <th>Ngày ghi chỉ số</th>
                                        <th>Chỉ số</th>
                                    </tr>
                                </thead>
                                <tbody class="text-center">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>



    <script>
        var accountData = [];
        $(document).ready(function () {

            //$('#modal_TieuThuDinhKy .modal-dialog').addClass('modal-dialog-scrollable');
            //$('#modal_TieuThuDinhKy .modal-body').addClass('ace-scrollbar');
            $('#modal_TieuThuDinhKy .modal-footer').addClass('d-none');


            $.ajax({
                url: '/Cate/AccountMobile/GetTieuThuDinhKy', // Server-side script to fetch questions
                method: 'POST',
                data: {
                    AccountUser: '@Model.AccountUser',
                    TypeAccount: '@Model.TypeAccount',
                },
                success: function (response) {
                    if (response.data != undefined) {
                        // lấy trong 12 tháng gần nhất
                        accountData = response.data.slice(0, 12);
                        console.log(response.data);
                        var _htmlChiTiet = '';
                        var _htmlLichCS = '';

                        var lstMonth = [];
                        var data = [];
                        for (var i = 0; i < accountData.length; i++) {
                            var hr = (i == accountData.length-1) ? '' : `<hr class="brc-secondary-l3">`;
                            var height = (i == accountData.length-1) ? '' : 'h-100';
                            _htmlChiTiet += `<div class="text-grey-m1 text-95">
                                        <div class="d-flex">
                                            <div class="minh-100 pos-rel">
                                                <div class="position-tl ml-4 ${height} border-l-3 brc-secondary-l1"></div>
                                                <div class="pos-rel text-center pt-1 mx-2px w-6 h-6 border-1 radius-round bgc-white brc-info-l1 text-170">
                                                    <i class=" fas fa-tint text-info-m3"></i>
                                                </div>
                                            </div>
                                            <div class="mx-2 flex-grow-1">
                                                <div>
                                                    <a href="javascript:void(0);" class="font-bolder text-110 btn-text-info btn-h-text-warning d-flex">
                                                        Tháng ${parseInt(moment(accountData[i].Period).format("MM"))}
                                                    </a>
                                                    <div class="text-95 text-secondary ml-auto text-nowrap">
                                                        (${moment(accountData[i].FromDate).format("DD/MM/YYYY")} - ${moment(accountData[i].ToDate).format("DD/MM/YYYY")})
                                                    </div>
                                                </div>

                                                <div class="text-grey-d3 text-95 mt-15 pos-rel row">
                                                    <div class="col-md-6">Tổng lượng nước tiêu thụ: <span class="text-110 text-danger-d1 text-600">${accountData[i].Consumption.toLocaleString('vi-VN')}</span> m<sup>3</sup></div>
                                                    <div class="col-md-6">Chỉ số cuối: <span class="text-110 text-green-d1 text-600">${accountData[i].LastNumber.toLocaleString('vi-VN')}</span></div>
                                                </div>
                                                ${hr}
                                            </div>
                                        </div>
                                    </div>`;
                            _htmlLichCS += `<tr>
                                    <td>${i+1}</td>
                                    <td>${moment(accountData[i].Period).format("MM/YYYY")}</td>
                                    <td>${moment(accountData[i].ToDate).format("DD/MM/YYYY")}</td>
                                    <td>${accountData[i].LastNumber.toLocaleString('vi-VN')}</td>
                                </tr>`;

                            lstMonth.push(moment(accountData[i].Period).format("MM/YYYY"));
                            data.push(accountData[i].Consumption);
                        }
                        // chi tiết chỉ số tiêu thụ nước
                        $('#profile16').html(_htmlChiTiet);
                        $('#LichGhiChiSo tbody').html(_htmlLichCS);

                        var options = {
                            series: [{
                                name: 'Tiêu thụ (m<sup>3</sup>)',
                                data: data
                            }],
                            chart: {
                                height: 350,
                                type: 'area'
                            },
                            dataLabels: {
                                enabled: true
                            },
                            stroke: {
                                curve: 'smooth'
                            },
                            xaxis: {
                                categories: lstMonth
                            },
                        };
                        var chart = new ApexCharts(document.querySelector("#chart"), options);
                        chart.render();

                    }
                },
                error: function (xhr, status, error) {

                }
            });
        });
    </script>
}

@section ContinueForm{

}