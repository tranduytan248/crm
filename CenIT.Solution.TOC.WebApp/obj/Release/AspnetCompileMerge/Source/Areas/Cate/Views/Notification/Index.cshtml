    //    // 4 - Tổng hợp đồng đã nhận thông báo
    //    $(tfoot[4]).find("th:last").text(data.TotalReceived);

    //    // 5 - Tổng hợp đồng chưa nhận thông báo sử dụng android
    //    $(tfoot[5]).find("th:last").text(data.TotalAndroidNotReceived);

    //    // 6 - Tổng hợp đồng chưa nhận thông báo sử dụng ios
    //    $(tfoot[6]).find("th:last").text(data.TotalIOSNotReceived);
    //}

    function LoadFooterStatistic(data) {
        var tfoot = $("#TableStatistic tfoot tr");

        // 1 - Tổng số hợp đồng chưa thanh toán
        $(tfoot[1]).find("th:last").html(
            `<a id="CateDetailNotification_AllUnpaid" data-modal data-modal-id="CateDetailNotification"
            href="/Cate/Notification/DetailNotification/?Type=AllUnpaid"
            title="Xem chi tiết" data-original-title="Xem chi tiết">
            ${data.TotalUnpaid}
        </a>`
        );

        // 2 - Tổng hợp đồng có cung cấp thông tin thông báo
        $(tfoot[2]).find("th:last").html(
            `<a id="CateDetailNotification_HasDevice" data-modal data-modal-id="CateDetailNotification"
            href="/Cate/Notification/DetailNotification/?Type=HasDevice"
            title="Xem chi tiết" data-original-title="Xem chi tiết">
            ${data.TotalHasDevice}
        </a>`
        );

        // 3 - Tổng hợp đồng có thông tin thông báo nhưng chưa thanh toán
        $(tfoot[3]).find("th:last").html(
            `<a id="CateDetailNotification_HasDeviceUnpaid" data-modal data-modal-id="CateDetailNotification"
            href="/Cate/Notification/DetailNotification/?Type=HasDeviceUnpaid"
            title="Gửi thông báo" data-original-title="Gửi thông báo">
            ${data.TotalHasDeviceUnpaid}
        </a>`
        );

        // 4 - Tổng hợp đồng đã nhận thông báo
        $(tfoot[4]).find("th:last").html(
            `<a id="CateDetailNotification_Received" data-modal data-modal-id="CateDetailNotification"
            href="/Cate/Notification/DetailNotification/?Type=Received"
            title="Xem chi tiết" data-original-title="Xem chi tiết">
            ${data.TotalReceived}
        </a>`
        );

        // 5 - Tổng hợp đồng chưa nhận thông báo (Android)
        $(tfoot[5]).find("th:last").html(
            `<a id="CateDetailNotification_Android" data-modal data-modal-id="CateDetailNotification"
            href="/Cate/Notification/DetailNotification/?Type=NotReceived_Android"
            title="Xem chi tiết" data-original-title="Xem chi tiết">
            ${data.TotalAndroidNotReceived}
        </a>`
        );

        // 6 - Tổng hợp đồng chưa nhận thông báo (iOS)
        $(tfoot[6]).find("th:last").html(
            `<a id="CateDetailNotification_iOS" data-modal data-modal-id="CateDetailNotification"
            href="/Cate/Notification/DetailNotification/?Type=NotReceived_iOS"
            title="Xem chi tiết" data-original-title="Xem chi tiết">
            ${data.TotalIOSNotReceived}
        </a>`
        );
    }



</script>