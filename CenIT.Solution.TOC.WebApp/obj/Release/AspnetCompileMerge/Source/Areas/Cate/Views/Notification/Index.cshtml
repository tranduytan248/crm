@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Notification_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
}
@{
    var currentMonth = DateTime.Now.ToString("MM/yyyy");
}
<style>
    /* Khối tìm kiếm */
    #Searching .form-group {
        margin-bottom: 15px;
    }

    #Searching label {
        font-weight: 600;
        margin-bottom: 5px;
        display: block;
    }

    #Searching .input-group-addon {
        background: #f1f1f1;
        border: 1px solid #ddd;
    }

    #Searching .input-group .form-control {
        border-left: 0;
    }

    /* Nút Thống kê */
    .btn-primary {
        padding: 8px 25px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 4px;
    }

    /* Bảng thống kê */
    #TableStatistic {
        margin-top: 20px;
        background: white;
    }

        #TableStatistic tfoot th {
            padding: 12px 10px;
            font-size: 14px;
            font-weight: 600;
            background: #fafafa !important;
            border-bottom: 1px solid #ddd;
        }

        #TableStatistic tr:nth-child(odd) th {
            background: #f7f7f7 !important;
        }

        #TableStatistic tr th:last-child {
            text-align: right !important;
            color: #333;
        }

    /* Tăng khoảng cách tổng thể */
    .box {
        padding: 15px 20px;
    }

    /* Gọn gàng hơn ở footer */
    .box-footer {
        padding: 15px 0;
        background: #fff;
        border-top: 1px solid #eee;
    }
</style>

<div class="box box-primary">

    <!-- /.box-header -->
    <div class="box-body with-border">
        <div class="" id="Searching">
            <div class=" row d-inline-flex align-items-center mb-1 col-md-6">
                <label class="my-auto font-bold pr-2 text-sm col-2">Giai đoạn</label>
                @Html.TextBox("Period", currentMonth, new { @class = "col-3 form-control form-control-sm pr-475", placeholder = "mm/yyyy", })
                <i class="far fa-calendar-alt text-primary text-125 ml-n45"></i>
            </div>
        </div>
    </div>
    <!-- ./box-body -->
