    <div class="row">
        <div class="col-sm-12 table-responsive">
            <table id="TableStatistic" class="table table-hover table-bordered table-striped" width="100%">
                <thead>

                </thead>
                <tfoot class="bg-gray">
                    <tr>
                        <th class="dt-body-center" colspan="2"></th>
                        <th class="dt-body-right" colspan="2">Tổng số hợp đồng</th>
                    </tr>
                    <tr>
                        <th class="dt-body-left" colspan="2">1 - Tổng số hợp đồng chưa thanh toán</th>
                        <th class="dt-body-right" colspan="2"></th>
                    </tr>
                    <tr>
                        <th class="dt-body-left" colspan="2">2 - Tổng hợp đồng có cung cấp thông tin thông báo</th>
                        <th class="dt-body-right" colspan="2"></th>

                    </tr>
                    <tr>
                        <th class="dt-body-left" colspan="2">3 - Tổng hợp đồng có thông tin thông báo nhưng chưa thanh toán</th>
                        <th class="dt-body-right" colspan="2"></th>
                    </tr>
                    <tr>
                        <th class="dt-body-left" colspan="2">4 - Tổng hợp đồng đã nhận thông báo</th>
                        <th class="dt-body-right" colspan="2"></th>
                    </tr>
                    <tr>
                        <th class="dt-body-left" colspan="2">5 - Tổng hợp đồng chưa nhận thông báo sử dụng android</th>
                        <th class="dt-body-right" colspan="2"></th>

                    </tr>
                    <tr>
                        <th class="dt-body-left" colspan="2">6 - Tổng hợp đồng chưa nhận thông báo sử dụng ios</th>
                        <th class="dt-body-right" colspan="2"></th>

                    </tr>

                </tfoot>
            </table>
        </div>
    </div>
    <hr />
</div>
<div class="w-200" id="NotifyAllDevice" style="display: flex; justify-content: end">
    <a id="SendNotificationAllDevice" {8}="" data-modal="" data-modal-id="SendNotificationAllDevice" class="btn btn-lighter-danger py-2 text-600 text-90 pull-right" data-rel="tooltip" title="" href="/Cate/Notification/SendNotificationAllDevice?period=@currentMonth" data-original-title="Gửi thông báo" style="float: right;"><i class="fas fa-bell text-warning text-120"></i> Gửi đến tất cả thiết bị chưa thanh toán</a>
</div>

<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSContractUnPaid" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Notification_Label_AccountUser")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Notification_Label_ContractCode")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Notification_Label_DeviceOs")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Notification_Label_Amount")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Cate/Views/Notification/Notification.js")"></script>
}
<script>
    $(document).ready(function () {
        $(document).ready(function () {
            ///// cấu hình lại datepicker: begin /////
            $.fn.datepicker.dates["vi"] = {
                days: ["Chủ nhật", "Thứ hai", "Thứ ba", "Thứ tư", "Thứ năm", "Thứ sáu", "Thứ bảy", "Chủ nhật"],
                daysShort: ["CN", "T2", "T3", "T4", "T5", "T6", "T7", "CN"],
                daysMin: ["CN", "T2", "T3", "T4", "T5", "T6", "T7", "CN"],
                months: ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"],
                monthsShort: ["Th01", "Th02", "Th03", "Th04", "Th05", "Th06", "Th07", "Th08", "Th09", "Th10", "Th11", "Th12"],
                today: "Hôm nay"
            };
            $("#Searching #Period").datepicker({
                viewMode: "years",
                minViewMode: "months",
                format: "MM/yyyy",
                autoclose: true,
                todayhighlight: true,
                todaybtn: true,
                minDate: null,
                maxDate: null,
                weekStart: 1,
                orientation: "bottom",
                language: "vi"
            }).on('changeDate', function (e) {
                GetStatistic();
            });
            initTableNotification();
            GetStatisticSumary();
        })

    });

    function GetStatistic() {
        GetStatisticSumary();
        _tableNotification.ajax.reload();
        var Period = $("#Searching #Period").val();
        $("#NotifyAllDevice").html(`
    <a id="SendNotificationAllDevice" {8}="" data-modal="" data-modal-id="SendNotificationAllDevice" class="btn btn-lighter-danger py-2 text-600 text-90 pull-right" data-rel="tooltip" title="" href="/Cate/Notification/SendNotificationAllDevice?period=${Period}" data-original-title="Gửi thông báo" style="float: right;"><i class="fas fa-bell text-warning text-120"></i> Gửi đến tất cả thiết bị chưa thanh toán</a>
        `)
    }

    function GetStatisticSumary() {
        var period = $("#Period").val();
        $.ajax({
            url: '/Cate/Notification/CountContractNoticeSummary',
            type: 'POST',
            data: { Period: period },
            success: function (res) {
                if (res && res.data) {
                    LoadFooterStatistic(res.data);
                }
            },
            error: function () {
                alert("Lỗi khi tải số liệu");
            }
        });
    }

    //function LoadFooterStatistic(data) {
