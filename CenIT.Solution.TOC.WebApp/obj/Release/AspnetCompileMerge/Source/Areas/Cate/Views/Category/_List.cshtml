@model Core.Cate.Models.Cate_GroupCategoryModel
@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("GroupCategory_Title") + " [" + Model.Group_Category_Name + "]";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    green
}

@section FormIcon{
    <i class="fas fa-list-ol"></i>
}

@section FormBody{
    <div class="text-right">
        @Html.Button(true, "AddCategory", Url.Action("Add", new { area = "Cate", GroupId = Model.Group_Category_ID }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right" })
    </div>
    @Html.HiddenFor(m => m.Group_Category_ID)
    <div class="mt-3">
        <div class="card dcard">
            <div class="col-sm-12 table-responsive-md p-2">
                <table id="DSCategory" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                    <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                        <tr>
                            <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Category_Code")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Category_Name")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Category_Priority")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
    <script src="@Url.Content("~/Areas/Cate/Views/Category/Category.js")?t=@DateTime.Now.ToString("ddMMyyyyHHmmss")"></script>
}

@section SubmitControl{

}
