@using TSFramework.Libs.Processors
@model Core.Cate.Models.MN_BoPhanModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("BoPhan_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "BoPhan", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "BoPhan_OnProcessSuccess(data, 'DeleteBoPhan')"
    }, new { @class = "form-horizontal", id = "DeleteBoPhan" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.BoPhan_ID)
        @Html.HiddenFor(model => model.MaBoPhan)
        @Html.HiddenFor(model => model.TenBoPhan)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}