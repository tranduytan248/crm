@using TSFramework.Libs.Processors
@model Core.Cate.Models.KWC_WaterOutagesModel

@{
    ViewBag.Title = "Cập nhật trạng thái lịch ngưng cấp nước";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    warning
}

@section FormBody{
    @using (Ajax.BeginForm("UpdateStatus", "WaterOutages", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "WaterOutages_OnProcessSuccess(data, 'UpdateStatusWaterOutages')"
    }, new { @class = "form-horizontal", id = "DeleteWaterOutages" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.OutageId)
        @Html.HiddenFor(model => model.Area)
        @Html.HiddenFor(model => model.StartTime)
        @Html.HiddenFor(model => model.EndTime)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}