@model Core.Cate.Models.Cate_Request_ChangeRegistrationInfoModel
@Html.ValidationMessage("CaptchaInputText", "", new { @class = "text-danger d-none" })
@Html.HiddenFor(model => model.RequestType)
@Html.AntiForgeryToken()
<div class="">
    <div class="title_template">Thông tin hiện tại</div>
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.TextBoxFor(m => m.RequesterName, new { @readonly = "", @class = "form-control shadow-none radius-5", placeholder = "" })
        @Html.TitleFor(model => model.RequesterName, new { @class = "floating-label " })
    </div>
    <div class="row mx-auto">
        <div class="col-6 pl-0 pr-1">
            <div class="input-floating-label brc-blue-m1 mt-3">
                @Html.TextBoxFor(m => m.Phone, new { @readonly = "", @class = "form-control shadow-none radius-5", placeholder = "" })
                @Html.TitleFor(model => model.Phone, new { @class = "floating-label " })
            </div>
        </div>
        <div class="col-6 pl-1 pr-0">
            <div class="input-floating-label brc-blue-m1 mt-3   ">
                @Html.TextBoxFor(m => m.ContractCode, new { @readonly = "", @class = "form-control shadow-none radius-5", placeholder = "" })
                @Html.TitleFor(model => model.ContractCode, new { @class = "floating-label " })
            </div>
        </div>
    </div>
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.TextAreaFor(m => m.AddressCus, new { @readonly = "", @class = "form-control shadow-none radius-5", placeholder = "", @rows = "1" })
        @Html.TitleFor(model => model.AddressCus, new { @class = "floating-label" })
    </div>
    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
</div>
<div class="">
    <div class="title_template">Thông tin yêu cầu thay đổi</div>
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.TextBoxFor(m => m.CustomerNameChange, new { @class = "form-control shadow-none radius-5", placeholder = "" })
        @Html.TitleFor(model => model.CustomerNameChange, new { @class = "floating-label " })
    </div>
    @Html.ValidationMessageFor(model => model.CustomerNameChange, "", new { @class = "text-danger" })

    <div class="row mx-auto">
        <div class="col-6 pl-0 pr-1">
            <div class="input-floating-label brc-blue-m1 mt-3">
                @Html.TextBoxFor(m => m.PhoneChange, new { @class = "form-control shadow-none radius-5", placeholder = "", @onfocus = "$(\"#PhoneChange\").inputmask(\"9999999999\");" })
                @Html.TitleFor(model => model.PhoneChange, new { @class = "floating-label " })
            </div>
            @Html.ValidationMessageFor(model => model.PhoneChange, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row mx-auto">
        <div class="col-7 pl-0 pr-1">
            <div class="input-floating-label brc-blue-m1 mt-3">
                @Html.TextBoxFor(m => m.CustomerTypeNameChange, new { @class = "form-control shadow-none radius-5", placeholder = "" })
                @Html.TitleFor(model => model.CustomerTypeNameChange, new { @class = "floating-label " })
            </div>
            @Html.ValidationMessageFor(model => model.CustomerTypeNameChange, "", new { @class = "text-danger" })
        </div>
        <div class="col-5 pl-1 pr-0">
            <div class="input-floating-label brc-blue-m1 mt-3   ">
                @Html.TextBoxFor(m => m.FamilyNumberChange, new { @class = "form-control shadow-none radius-5 int-number", placeholder = "" })
                @Html.TitleFor(model => model.FamilyNumberChange, new { @class = "floating-label " })
            </div>
        </div>
    </div>
    <div class="input-floating-label brc-blue-m1 mt-3">
        @Html.TextAreaFor(m => m.Reason, new { @class = "form-control shadow-none radius-5", placeholder = "", @rows = "1" })
        @Html.TitleFor(model => model.Reason, new { @class = "floating-label " })
    </div>
    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
</div>
@Html.RenderScripts(ScriptPosition.BodyInside)
<script>
    $(document).ready(function () {
        $("#dz-area").addClass('d-none');
        for (var i = 0; i < $('.form-control').length; i++) {
            $('.form-control').eq(i).attr('placeholder', ' ');
        }
        // input mask int
        $(document).on("input", ".int-number", function (e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
        SetHeightTextarea(['Reason', 'AddressCus']);
    });
</script>
