@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_ServiceRequestsModel
@{
    ViewBag.Title = "Thay đổi tiến trình xử lý";
    Layout = "~/Views/Shared/_Form.cshtml";
}
@section FormType{primary}
@section FormIcon{<i class="far fa-edit"></i>}
@section FormBody{


    <style>
        .list_img img {
            height: 100px;
            width: 100px;
            padding: 5px;
        }
    </style>
    <div class="row">
        <div class="col-md-7 mt-lg-0 pr-lg-2">
            @{ Html.RenderAction("GetHistoryChangeStatus", "ServiceRequests", new { area = "Cate", RequestId = Model.RequestId});}
            <div class="position-rc h-100 border-l-1 brc-secondary-l3"></div>
        </div>
        <div class="col-md-5">
            @{ Html.RenderAction("GetInforCustomerRequest", "ServiceRequests", new { area = "Cate", RequestId = Model.RequestId });}
            @if (!Model.IsFinished)
            {
                <div class="card mb-3">
                    <div class="card-header bg-transparent brc-default-l3">
                        <h5 class="card-title text-dark-m2 pl-1 text-130 text-success">
                            <i class="far fa-paper-plane"></i> Cập nhật trạng thái xử lý
                        </h5>
                    </div>
                    <div class="card-body py-0 border-0">
                        @using (Html.BeginForm("UpdateStatusProcess", "ServiceRequests", FormMethod.Post, new { area = "Cate", id = "FormUpdateStatusProcess", @class = "form-horizontal" }))
                        {
                            <div id="bodyForm">
                                @Html.Partial("_UpdateStatusProcessView")
                            </div>
                        }
                    </div><!-- /.card-body -->
                    <div class="card-footer bgc-white px-4 py-3 brc-dark-l3 d-flex justify-content-end">
                        <button type="button" id="btnSaveStatusProcess" class="float-right btn btn-primary text-600">
                            <i class="far fa-paper-plane mr-1"></i> Cập nhật trạng thái
                        </button>
                    </div><!-- /.card-footer -->
                </div>
            }

        </div>
    </div>
    <script>
        $(document).ready(function () {

            $('#modal_UpdateStatusProcess .modal-dialog').addClass('modal-dialog-scrollable');
            $('#modal_UpdateStatusProcess .modal-body').addClass('ace-scrollbar');
            $('#modal_UpdateStatusProcess .modal-footer').addClass('d-none');


            $("#btnSaveStatusProcess").click(function () {
                $('form#FormUpdateStatusProcess').submit();
            })
            $('form#FormUpdateStatusProcess').ajaxForm({
                success: function (response) {
                    if (response.status != undefined) {
                        $("#ModalContent #modal_UpdateStatusProcess").modal("hide");
                        $("#ModalContent #modal_UpdateStatusProcess").on("hidden.bs.modal",
                            function () {
                                if (response.status != undefined) {
                                    eval(response.message);
                                    _tableServiceRequests.ajax.reload(null, false);
                                    response.status = undefined;
                                }
                            });
                    } else {
                        $("#FormUpdateStatusProcess " + "#bodyForm").html(response);
                    }
                }
            });
        });
    </script>
}
@section SubmitControl{
}