@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Notification_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
}
@{
    var currentMonth = DateTime.Now.ToString("MM/yyyy");
}
<style>
    /* Khối tìm kiếm */
    #Searching .form-group {
        margin-bottom: 15px;
    }

    #Searching label {
        font-weight: 600;
        margin-bottom: 5px;
        display: block;
    }

    #Searching .input-group-addon {
        background: #f1f1f1;
        border: 1px solid #ddd;
    }

    #Searching .input-group .form-control {
        border-left: 0;
    }

    /* Nút Thống kê */
    .btn-primary {
        padding: 8px 25px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 4px;
    }

    /* Bảng thống kê */
    #TableStatistic {
        margin-top: 20px;
        background: white;
    }

        #TableStatistic tfoot th {
            padding: 12px 10px;
            font-size: 14px;
            font-weight: 600;
            background: #fafafa !important;
            border-bottom: 1px solid #ddd;
        }

        #TableStatistic tr:nth-child(odd) th {
            background: #f7f7f7 !important;
        }

        #TableStatistic tr th:last-child {
            text-align: right !important;
            color: #333;
        }

    /* Tăng khoảng cách tổng thể */
    .box {
        padding: 15px 20px;
    }

    /* Gọn gàng hơn ở footer */
    .box-footer {
        padding: 15px 0;
        background: #fff;
        border-top: 1px solid #eee;
    }
</style>

<div class="box box-primary">

    <!-- /.box-header -->
    <div class="box-body with-border">
        <div class="" id="Searching">
            <div class=" row d-inline-flex align-items-center mb-1 col-md-6">
                <label class="my-auto font-bold pr-2 text-sm col-2">Giai đoạn</label>
                @Html.TextBox("Period", currentMonth, new { @class = "col-3 form-control form-control-sm pr-475", placeholder = "mm/yyyy", })
                <i class="far fa-calendar-alt text-primary text-125 ml-n45"></i>
            </div>
        </div>
    </div>
    <!-- ./box-body -->
    @*<div class="box-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="GetStatistic()">Thống kê</button>
            </div>
        </div>*@
    @*<div class="w-200" id="NotifyEmailAllDevice">
        <a id="SendNotificationEmailAllDevice" {8}="" data-modal="" data-modal-id="SendNotificationEmailAllDevice" class="btn btn-lighter-danger mr-1 dropdown-item" data-rel="tooltip" title="" href="/Cate/NotificationByEmail/SendNotificationEmailAllDevice?period=@currentMonth" data-original-title="Gửi thông báo"><i class="fas fa-bell text-warning text-120"></i> Gửi đến tất cả khách hàng chưa thanh toán bằng email</a>

    </div>*@
    <div class="w-200" id="NotifyEmailAllDevice" style="display: flex; justify-content: end">
        <a id="SendNotificationEmailAllDevice" {8}="" data-modal="" data-modal-id="SendNotificationEmailAllDevice" class="btn btn-lighter-danger py-2 text-600 text-90 pull-right" data-rel="tooltip" title="" href="/Cate/NotificationByEmail/SendNotificationEmailAllDevice?period=@currentMonth" data-original-title="Gửi thông báo" style="float: right;"><i class="fas fa-bell text-warning text-120"></i> Gửi đến tất cả khách hàng chưa nhận thông báo thanh toán bằng email</a>
    </div>

</div>
<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSContractRegisterReceiveEmail" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("NotificationByEmail_Label_Email")</th>
                        <th>@AppProcessor.Messagor.GetMessage("NotificationByEmail_Label_AccountUser")</th>
                        <th>@AppProcessor.Messagor.GetMessage("NotificationByEmail_Label_ContractCode")</th>
                        <th>@AppProcessor.Messagor.GetMessage("NotificationByEmail_Label_CustomerName")</th>
                        <th>@AppProcessor.Messagor.GetMessage("NotificationByEmail_Label_Amount")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Cate/Views/NotificationByEmail/NotificationByEmail.js")"></script>
}
<script>
    $(document).ready(function () {
        $(document).ready(function () {
            ///// cấu hình lại datepicker: begin /////
            $.fn.datepicker.dates["vi"] = {
                days: ["Chủ nhật", "Thứ hai", "Thứ ba", "Thứ tư", "Thứ năm", "Thứ sáu", "Thứ bảy", "Chủ nhật"],
                daysShort: ["CN", "T2", "T3", "T4", "T5", "T6", "T7", "CN"],
                daysMin: ["CN", "T2", "T3", "T4", "T5", "T6", "T7", "CN"],
                months: ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"],
                monthsShort: ["Th01", "Th02", "Th03", "Th04", "Th05", "Th06", "Th07", "Th08", "Th09", "Th10", "Th11", "Th12"],
                today: "Hôm nay"
            };
            $("#Searching #Period").datepicker({
                viewMode: "years",
                minViewMode: "months",
                format: "MM/yyyy",
                autoclose: true,
                todayhighlight: true,
                todaybtn: true,
                minDate: null,
                maxDate: null,
                weekStart: 1,
                orientation: "bottom",
                language: "vi"
            }).on('changeDate', function (e) {
                GetStatistic();
            });
            initTableNotification();
        })

    });

    function GetStatistic() {
        _tableNotification.ajax.reload();
        var Period = $("#Searching #Period").val();
        $("#NotifyEmailAllDevice").html(`
        <a id="SendNotificationEmailAllDevice" {8}="" data-modal="" data-modal-id="SendNotificationEmailAllDevice" class="btn btn-lighter-danger py-2 text-600 text-90 pull-right" data-rel="tooltip" title="" href="/Cate/NotificationByEmail/SendNotificationEmailAllDevice?period=${Period}" data-original-title="Gửi thông báo" style="float: right;"><i class="fas fa-bell text-warning text-120"></i> Gửi đến tất cả khách hàng chưa nhận thông báo thanh toán bằng email</a>
            `)
        }




</script>