@using TSFramework.Libs.Processors
@model Core.Cate.Models.KWC_AccountMobileModel

@{
    ViewBag.Title = $"Kích hoạt lại tài khoản - [{Model.AccountUser}]";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    success
}

@section FormBody{
    @using (Ajax.BeginForm("Active", "AccountMobile", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "AccountMobile_OnProcessSuccess(data, 'ActiveAccount')"
    }, new { @class = "form-horizontal", id = "ActiveAccount" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Account_ID)
        @Html.HiddenFor(model => model.CustomerName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}