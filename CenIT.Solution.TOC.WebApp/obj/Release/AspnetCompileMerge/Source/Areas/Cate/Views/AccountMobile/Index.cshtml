@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("AccountMobile_Title");
}

@section PageTitle
{
    @ViewBag.Title
}
<style>
    .w1pc {
        width: 1% !important;
    }
</style>
@Html.Partial("_Search")
<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md p-2">
            <table id="DSAccountMobile" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="w1pc">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("FullName_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("UserName")</th>
                        <th>@AppProcessor.Messagor.GetMessage("News_Label_Status")</th>
                        <th>@AppProcessor.Messagor.GetMessage("AccountMoblie_Label_StatusSendEmail")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Contents/Base/plugins/apexcharts/apexcharts.min.js")"></script>

    @*<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>*@
    <script src="@Url.Content("~/Areas/Cate/Views/AccountMobile/AccountMobile.js")?t=@DateTime.Now.ToString("ddMMyyyy")"></script>
}