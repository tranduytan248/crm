@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_BannerModel

@Html.AntiForgeryToken()
<div id="Language">
    @Html.HiddenFor(model => model.BannerId)

    <div class="row">
        <label class="col-sm-12 col-form-label text-sm-left pr-0 font-bold" for="ImageUrlPath">Hình ảnh (<span style="color:red">Banner hiển thị đẹp nhất với ảnh có tỷ lệ 7:3 (ví dụ 1400×600, 2100×900).</span>)</label>
        <div class="col-12 col-md-12">
            <div class="ace-file-input ace-file-multiple">
                <div class="ace-file-container d-flex flex-column border-1 border-dashed brc-primary-m4 brc-h-warning-m1">
                    <div class="ace-file-placeholder h-100">
                        @Html.ImageForNews(model => model.ImageUrlFileBase, Model.ImageUrlPath, AppProcessor.Messagor.GetMessage("Employee_Avatar"), ".jpeg,.png,.gif,.jpg", new { @class = "col-sm-12 col-md-12 mx-auto my-1" })
                        @Html.HiddenFor(model => model.ImageUrl)
                    </div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.ImageUrl, "", new { @class = "text-danger" })
        </div>
      

    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.URLRedirect, new { @class = "col-sm-2 col-form-label text-sm-left pr-0 font-bold" })
        <div class="col-md-12">
            @Html.TextBoxFor(model => model.URLRedirect, new { @class = "w-100", placeholder = AppProcessor.Messagor.GetMessage("Banners_Label_URLRedirect") })
            @Html.ValidationMessageFor(model => model.URLRedirect, "", new { @class = "text-danger" })
        </div>
    </div>
    
</div>

@Html.RenderScripts(ScriptPosition.BodyInside)
