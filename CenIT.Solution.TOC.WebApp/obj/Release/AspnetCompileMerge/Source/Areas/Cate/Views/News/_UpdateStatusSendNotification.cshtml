@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_NewsModel

@{
    ViewBag.Title = "Cập nhật trạng thái tin tức";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    warning
}

@section FormBody{
    @using (Ajax.BeginForm("UpdateStatusSendNotification", "News", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "News_OnProcessSuccess(data, 'UpdateStatusSendNotificationNews')"
    }, new { @class = "form-horizontal", id = "UpdateStatusSendNotificationNews" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.NewsId)
        @Html.HiddenFor(model => model.Title)
        @Html.HiddenFor(model => model.Summary)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}