@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_StatusProcessModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("StatusProcess_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "StatusProcess", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "StatusProcess_OnProcessSuccess(data, 'DeleteStatusProcess')"
    }, new { @class = "form-horizontal", id = "DeleteStatusProcess" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.StatusProcessId)
        @Html.HiddenFor(model => model.StatusProcessName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}