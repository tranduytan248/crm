@using TSFramework.Libs.Processors
@model Core.Cate.Models.MN_ChucVuModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ChucVu_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "ChucVu", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ChucVu_OnProcessSuccess(data, 'DeleteChucVu')"
    }, new { @class = "form-horizontal", id = "DeleteChucVu" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ChucVu_ID)
        @Html.HiddenFor(model => model.MaChucVu)
        @Html.HiddenFor(model => model.TenChucVu)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}